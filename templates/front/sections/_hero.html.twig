<section class="hero {% if data.background_color is defined or (data.style is defined and data.style.background_color is defined) %}custom-bg{% endif %}" {% if data.background_color is defined %}style="background-color: {{ data.background_color }}; {% if data.padding_top is defined %}padding-top: {{ data.padding_top }}px; {% endif %}{% if data.padding_bottom is defined %}padding-bottom: {{ data.padding_bottom }}px; {% endif %}{% if data.margin_top is defined %}margin-top: {{ data.margin_top }}px; {% endif %}{% if data.margin_bottom is defined %}margin-bottom: {{ data.margin_bottom }}px; {% endif %}{% elseif data.style is defined and data.style.background_color is defined %}style="background-color: {{ data.style.background_color }}; {% if data.style.padding_top is defined %}padding-top: {{ data.style.padding_top }}px; {% endif %}{% if data.style.padding_bottom is defined %}padding-bottom: {{ data.style.padding_bottom }}px; {% endif %}{% if data.style.margin_top is defined %}margin-top: {{ data.style.margin_top }}px; {% endif %}{% if data.style.margin_bottom is defined %}margin-bottom: {{ data.style.margin_bottom }}px; {% endif %}"{% endif %}>
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <div class="hero-content {% if data.text_alignment is defined %}text-{{ data.text_alignment }}{% elseif data.style is defined and data.style.text_alignment is defined %}text-{{ data.style.text_alignment }}{% endif %}" {% if data.hero_text_color is defined %}style="color: {{ data.hero_text_color }}"{% elseif data.style is defined and data.style.hero_text_color is defined %}style="color: {{ data.style.hero_text_color }}"{% endif %}>
                    {% if data.hero_title is defined and data.hero_title %}<h1 class="display-4 mb-4" {% if data.title_color is defined %}style="color: {{ data.title_color }}"{% elseif data.style is defined and data.style.title_color is defined %}style="color: {{ data.style.title_color }}"{% endif %}>{{ data.hero_title }}</h1>{% endif %}
                    {% if data.hero_subtitle is defined and data.hero_subtitle %}
                        <p class="lead mb-4" {% if data.subtitle_color is defined %}style="color: {{ data.subtitle_color }}"{% elseif data.style is defined and data.style.subtitle_color is defined %}style="color: {{ data.style.subtitle_color }}"{% endif %}>{{ data.hero_subtitle }}</p>
                    {% endif %}
                    {% if data.primary_button_text is defined and data.primary_button_text and data.primary_button_url is defined and data.primary_button_url %}
                        <a href="{{ data.primary_button_url }}" class="btn btn-{% if data.primary_button_style is defined %}{{ data.primary_button_style }}{% elseif data.style is defined and data.style.primary_button_style is defined %}{{ data.style.primary_button_style }}{% else %}primary{% endif %} btn-lg" {% if data.primary_button_background_color is defined %}style="background-color: {{ data.primary_button_background_color }}; {% if data.primary_button_text_color is defined %}color: {{ data.primary_button_text_color }}; {% endif %}{% if data.primary_button_border_color is defined %}border-color: {{ data.primary_button_border_color }}; {% endif %}{% if data.primary_button_border_radius is defined %}border-radius: {{ data.primary_button_border_radius }}px; {% endif %}{% elseif data.style is defined and data.style.primary_button_background_color is defined %}style="background-color: {{ data.style.primary_button_background_color }}; {% if data.style.primary_button_text_color is defined %}color: {{ data.style.primary_button_text_color }}; {% endif %}{% if data.style.primary_button_border_color is defined %}border-color: {{ data.style.primary_button_border_color }}; {% endif %}{% if data.style.primary_button_border_radius is defined %}border-radius: {{ data.style.primary_button_border_radius }}px; {% endif %}"{% endif %}>
                            {{ data.primary_button_text }}
                        </a>
                    {% endif %}
                </div>
            </div>
            {% if data.hero_image_url is defined and data.hero_image_url %}
                <div class="col-lg-6 mt-4 mt-lg-0">
                    <div class="hero-media">
                        <img src="{{ data.hero_image_url }}" alt="{{ data.hero_title is defined ? data.hero_title : '' }}" class="img-fluid">
                    </div>
                </div>
            {% endif %}
        </div>
    </div>
</section>

{% if data.show_form is defined and data.show_form %}
<section class="section-sm bg-light">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">
                <div class="lead-form">
                    <h3 class="lead-form-title mb-4">Get in Touch</h3>
                    <form method="POST" action="{{ path('app_contact') }}" data-turbo="false">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('contact_form') }}">
                        <div class="mb-3">
                            <input type="text" class="form-control" name="name" placeholder="Your Name" required>
                        </div>
                        <div class="mb-3">
                            <input type="email" class="form-control" name="email" placeholder="Your Email" required>
                        </div>
                        <div class="mb-3">
                            <input type="tel" class="form-control" name="phone" placeholder="Your Phone">
                        </div>
                        <div class="mb-3">
                            <textarea class="form-control" name="message" rows="4" placeholder="Your Message" required></textarea>
                        </div>
                        <button type="submit" class="btn btn-primary w-100">Send Message</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
{% endif %}
