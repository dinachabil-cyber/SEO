{# Hero Section - Simplified Rendering #}
{# Uses field values directly from data (e.g., data.hero_title, data.primary_button_text) #}

{% import 'front/sections/_macros.html.twig' as macros %}

{% set hero_style = '' %}
{% if data.background_gradient is defined and data.background_gradient %}
    {% set hero_style = hero_style ~ 'background: ' ~ data.background_gradient ~ ';' %}
{% elseif data.background_color is defined and data.background_color %}
    {% set hero_style = hero_style ~ 'background-color: ' ~ data.background_color ~ ';' %}
{% elseif data.style is defined and data.style.background_color is defined %}
    {% set hero_style = hero_style ~ 'background-color: ' ~ data.style.background_color ~ ';' %}
{% endif %}
{% if data.padding_top is defined and data.padding_top %}
    {% set hero_style = hero_style ~ 'padding-top: ' ~ data.padding_top ~ 'px;' %}
{% endif %}
{% if data.padding_bottom is defined and data.padding_bottom %}
    {% set hero_style = hero_style ~ 'padding-bottom: ' ~ data.padding_bottom ~ 'px;' %}
{% endif %}
{% if data.margin_top is defined and data.margin_top %}
    {% set hero_style = hero_style ~ 'margin-top: ' ~ data.margin_top ~ 'px;' %}
{% endif %}
{% if data.margin_bottom is defined and data.margin_bottom %}
    {% set hero_style = hero_style ~ 'margin-bottom: ' ~ data.margin_bottom ~ 'px;' %}
{% endif %}

{% set text_style = '' %}
{% if data.hero_text_color is defined and data.hero_text_color %}
    {% set text_style = text_style ~ 'color: ' ~ data.hero_text_color ~ ';' %}
{% elseif data.style is defined and data.style.hero_text_color is defined %}
    {% set text_style = text_style ~ 'color: ' ~ data.style.hero_text_color ~ ';' %}
{% endif %}

{% set text_align_class = macros.text_align_class(data, 'text_alignment') %}

{% set hero_class = 'hero' %}
{% if data.background_color is defined or (data.style is defined and data.style.background_color is defined) %}
    {% set hero_class = hero_class ~ ' custom-bg' %}
{% endif %}

{# ---- Layout configuration from the "Layout Type" style select ---- #}
{% set layout_type = data.layout_type is defined and data.layout_type ? data.layout_type : 'form_left_image_right' %}

{% set show_image = data.show_image is defined ? data.show_image : true %}
{% set show_form  = data.show_form is defined ? data.show_form : false %}

{% set hero_image = '' %}
{% if data.hero_image_url is defined and data.hero_image_url %}
    {% set hero_image = data.hero_image_url %}
{% elseif data.left_image is defined and data.left_image %}
    {% set hero_image = data.left_image %}
{% endif %}

{% set has_image = show_image and hero_image %}
{% set has_form  = show_form %}

{# Image on the LEFT, form on the RIGHT #}
{% set image_left = (layout_type == 'image_left_form_right') %}

<section class="{{ hero_class }}" {% if hero_style %} style="{{ hero_style }}"{% endif %}>
    <div class="container">
        {# ---- TITLE / TEXT ALWAYS ABOVE THE IMAGE ---- #}
        {% if (data.hero_title is defined and data.hero_title)
            or (data.hero_subtitle is defined and data.hero_subtitle)
            or (data.description is defined and data.description)
            or (data.phone_number is defined and data.phone_number) %}
            <div class="hero-head {{ text_align_class }} mb-5" {% if text_style %} style="{{ text_style }}"{% endif %}>
                {% if data.hero_title is defined and data.hero_title %}
                    <h1 class="display-4 mb-4">
                        {{ data.hero_title }}
                    </h1>
                {% endif %}

                {% if data.hero_subtitle is defined and data.hero_subtitle %}
                    <p class="lead mb-4">
                        {{ data.hero_subtitle }}
                    </p>
                {% endif %}

                {% if data.description is defined and data.description %}
                    <p class="mb-4">{{ data.description }}</p>
                {% endif %}

                {% if data.phone_number is defined and data.phone_number %}
                    <div class="hero-phone mt-3">
                        <a href="tel:{{ data.phone_number }}" class="text-decoration-none">
                            <i class="bi bi-telephone me-2"></i>{{ data.phone_number }}
                        </a>
                    </div>
                {% endif %}
            </div>
        {% endif %}

        {# ---- IMAGE + FORM AREA (side by side, side depends on style select) ---- #}
        {% if has_image or has_form %}
            {% if layout_type == 'form_only' and has_form %}
                <div class="row justify-content-center">
                    <div class="col-lg-8 col-xl-6">
                        {% include 'front/sections/_hero_form.html.twig' with {data: data} %}
                    </div>
                </div>
            {% elseif layout_type == 'centered' %}
                <div class="row justify-content-center text-center">
                    <div class="col-lg-10 col-xl-8">
                        {% if has_image %}
                            <div class="hero-media mb-4">
                                <img src="{{ hero_image }}" alt="{{ data.hero_title is defined ? data.hero_title : '' }}" class="img-fluid">
                            </div>
                        {% endif %}
                        {% if has_form %}
                            {% include 'front/sections/_hero_form.html.twig' with {data: data} %}
                        {% endif %}
                    </div>
                </div>
            {% else %}
                <div class="row align-items-center g-4">
                    {% if image_left %}
                        {% if has_image %}
                            <div class="col-lg-6">
                                <div class="hero-media">
                                    <img src="{{ hero_image }}" alt="{{ data.hero_title is defined ? data.hero_title : '' }}" class="img-fluid">
                                </div>
                            </div>
                        {% endif %}
                        {% if has_form %}
                            <div class="col-lg-6">
                                {% include 'front/sections/_hero_form.html.twig' with {data: data} %}
                            </div>
                        {% endif %}
                    {% else %}
                        {% if has_form %}
                            <div class="col-lg-6">
                                {% include 'front/sections/_hero_form.html.twig' with {data: data} %}
                            </div>
                        {% endif %}
                        {% if has_image %}
                            <div class="col-lg-6">
                                <div class="hero-media">
                                    <img src="{{ hero_image }}" alt="{{ data.hero_title is defined ? data.hero_title : '' }}" class="img-fluid">
                                </div>
                            </div>
                        {% endif %}
                    {% endif %}
                </div>
            {% endif %}
        {% endif %}
    </div>
</section>
