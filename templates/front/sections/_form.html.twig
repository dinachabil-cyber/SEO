{% import 'front/sections/_macros.html.twig' as macros %}
<section class="section bg-white">
    <div class="container">
        {% if data.section_title is defined and data.section_title %}
            <div class="text-center mb-5">
                <h2>{{ data.section_title }}</h2>
            </div>
        {% endif %}
        
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">
                <div class="lead-form">
                    <form method="POST" action="{{ path('app_contact') }}" data-turbo="false">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('contact_form') }}">
                        
                        {% if data.form_fields is defined and data.form_fields %}
                            {% for field in data.form_fields %}
                                {{ macros.render_form_field(field) }}
                            {% endfor %}
                        {% else %}
                            {{ macros.render_fallback_form_fields() }}
                        {% endif %}
                        
                        <button type="submit" class="btn btn-primary w-100">
                            {{ data.submit_button_text|default('Submit') }}
                        </button>
                        
                        {% if data.success_message is defined and data.success_message %}
                            <div id="successMessage" class="alert alert-success mt-3 d-none">
                                {{ data.success_message }}
                            </div>
                        {% endif %}
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>