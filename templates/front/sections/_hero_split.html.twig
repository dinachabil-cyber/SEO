{% import 'front/sections/_macros.html.twig' as macros %}
<section class="hero-split {% if data.background_color is defined or (data.style is defined and data.style.background_color is defined) %}custom-bg{% endif %}" {% if data.background_color is defined %}style="background-color: {{ data.background_color }}; {% if data.padding_top is defined %}padding-top: {{ data.padding_top }}px; {% endif %}{% if data.padding_bottom is defined %}padding-bottom: {{ data.padding_bottom }}px; {% endif %}{% if data.margin_top is defined %}margin-top: {{ data.margin_top }}px; {% endif %}{% if data.margin_bottom is defined %}margin-bottom: {{ data.margin_bottom }}px; {% endif %}" {% elseif data.style is defined and data.style.background_color is defined %}style="background-color: {{ data.style.background_color }}; {% if data.style.padding_top is defined %}padding-top: {{ data.style.padding_top }}px; {% endif %}{% if data.style.padding_bottom is defined %}padding-bottom: {{ data.style.padding_bottom }}px; {% endif %}{% if data.style.margin_top is defined %}margin-top: {{ data.style.margin_top }}px; {% endif %}{% if data.style.margin_bottom is defined %}margin-bottom: {{ data.style.margin_bottom }}px; {% endif %}"{% endif %}>
    <div class="container">
        <div class="row align-items-center">
            {% if (data.layout_type is defined and data.layout_type == 'image-left' or data.layout is defined and data.layout == 'image-left') and data.hero_image_url is defined and data.hero_image_url %}
                <div class="col-lg-6 mt-4 mt-lg-0">
                    <div class="hero-media">
                        <img src="{{ data.hero_image_url }}" alt="{{ data.hero_title is defined ? data.hero_title : '' }}" class="img-fluid">
                    </div>
                </div>
            {% endif %}
            
            <div class="col-lg-6 {% if (data.layout_type is defined and data.layout_type == 'image-left' or data.layout is defined and data.layout == 'image-left') %}mt-4 mt-lg-0{% endif %}">
                {% set text_color = macros.get_value_raw(data, 'hero_text_color', '') %}
                <div class="hero-content" {% if text_color %}style="color: {{ text_color }}"{% endif %}>
                    {% set title_color = macros.get_value_raw(data, 'title_color', '') %}
                    <h1 class="display-4 mb-4" {% if title_color %}style="color: {{ title_color }}"{% endif %}>{{ data.hero_title is defined ? data.hero_title : '' }}</h1>
                    
                    {% set subtitle_color = macros.get_value_raw(data, 'subtitle_color', '') %}
                    {% if data.hero_subtitle is defined and data.hero_subtitle %}
                        <p class="lead mb-4" {% if subtitle_color %}style="color: {{ subtitle_color }}"{% endif %}>{{ data.hero_subtitle }}</p>
                    {% endif %}
                    
                    {% if data.primary_button_text is defined and data.primary_button_text and data.primary_button_url is defined and data.primary_button_url %}
                        {% set btn_style = macros.button_style_string(data, 'primary_button_background_color', 'primary_button_text_color', 'primary_button_border_color', 'primary_button_border_radius') %}
                        <a href="{{ data.primary_button_url }}" class="btn btn-{% if data.primary_button_style is defined %}{{ data.primary_button_style }}{% elseif data.style is defined and data.style.primary_button_style is defined %}{{ data.style.primary_button_style }}{% else %}primary{% endif %} btn-lg" {% if btn_style %}style="{{ btn_style }}"{% endif %}>
                            {{ data.primary_button_text }}
                        </a>
                    {% endif %}
                </div>
            </div>
            
            {% if (data.layout_type is defined and data.layout_type == 'text-left' or data.layout is defined and data.layout == 'text-left') and data.hero_image_url is defined and data.hero_image_url %}
                <div class="col-lg-6 mt-4 mt-lg-0">
                    <div class="hero-media">
                        <img src="{{ data.hero_image_url }}" alt="{{ data.hero_title is defined ? data.hero_title : '' }}" class="img-fluid">
                    </div>
                </div>
            {% endif %}
        </div>
        
        {% if data.form_title is defined and data.form_title %}
            <div class="row justify-content-center mt-5">
                <div class="col-md-8 col-lg-6">
                    <div class="lead-form">
                        <h3 class="lead-form-title mb-4">{{ data.form_title }}</h3>
                        <form method="POST" action="{{ path('app_contact') }}" data-turbo="false">
                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('contact_form') }}">
                            {{ macros.render_fallback_form_fields() }}
                            <button type="submit" class="btn btn-primary w-100">Send Message</button>
                        </form>
                    </div>
                </div>
            </div>
        {% endif %}
    </div>
</section>