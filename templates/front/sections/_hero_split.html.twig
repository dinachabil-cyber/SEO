<section class="hero-split {% if data.backgroundColor is defined or (data.style is defined and data.style.backgroundColor is defined) %}custom-bg{% endif %}" {% if data.backgroundColor is defined %}style="background-color: {{ data.backgroundColor }}; {% if data.paddingTop is defined %}padding-top: {{ data.paddingTop }}px; {% endif %}{% if data.paddingBottom is defined %}padding-bottom: {{ data.paddingBottom }}px; {% endif %}{% if data.marginTop is defined %}margin-top: {{ data.marginTop }}px; {% endif %}{% if data.marginBottom is defined %}margin-bottom: {{ data.marginBottom }}px; {% endif %}" {% elseif data.style is defined and data.style.backgroundColor is defined %}style="background-color: {{ data.style.backgroundColor }}; {% if data.style.paddingTop is defined %}padding-top: {{ data.style.paddingTop }}px; {% endif %}{% if data.style.paddingBottom is defined %}padding-bottom: {{ data.style.paddingBottom }}px; {% endif %}{% if data.style.marginTop is defined %}margin-top: {{ data.style.marginTop }}px; {% endif %}{% if data.style.marginBottom is defined %}margin-bottom: {{ data.style.marginBottom }}px; {% endif %}"{% endif %}>
    <div class="container">
        <div class="row align-items-center">
            {% if data.layout is defined and data.layout == 'image-left' and data.imageUrl is defined and data.imageUrl %}
                <div class="col-lg-6">
                    <div class="hero-media">
                        <img src="{{ data.imageUrl }}" alt="{{ data.title is defined ? data.title : '' }}">
                    </div>
                </div>
            {% endif %}
            
            <div class="col-lg-6">
                <div class="hero-content" {% if data.textColor is defined %}style="color: {{ data.textColor }}"{% elseif data.style is defined and data.style.textColor is defined %}style="color: {{ data.style.textColor }}"{% endif %}>
                    <h1 class="display-4 mb-4" {% if data.titleColor is defined %}style="color: {{ data.titleColor }}"{% elseif data.style is defined and data.style.titleColor is defined %}style="color: {{ data.style.titleColor }}"{% endif %}>{{ data.title is defined ? data.title : '' }}</h1>
                    {% if data.subtitle is defined and data.subtitle %}
                        <p class="lead mb-4" {% if data.subtitleColor is defined %}style="color: {{ data.subtitleColor }}"{% elseif data.style is defined and data.style.subtitleColor is defined %}style="color: {{ data.style.subtitleColor }}"{% endif %}>{{ data.subtitle }}</p>
                    {% endif %}
                    {% if data.ctaText is defined and data.ctaText and data.ctaUrl is defined and data.ctaUrl %}
                        <a href="{{ data.ctaUrl }}" class="btn btn-{% if data.buttonStyle is defined %}{{ data.buttonStyle }}{% elseif data.style is defined and data.style.buttonStyle is defined %}{{ data.style.buttonStyle }}{% else %}primary{% endif %} btn-lg" {% if data.buttonBackgroundColor is defined %}style="background-color: {{ data.buttonBackgroundColor }}; {% if data.buttonTextColor is defined %}color: {{ data.buttonTextColor }}; {% endif %}{% if data.buttonBorderColor is defined %}border-color: {{ data.buttonBorderColor }}; {% endif %}{% if data.buttonBorderRadius is defined %}border-radius: {{ data.buttonBorderRadius }}px; {% endif %}" {% elseif data.style is defined and data.style.buttonBackgroundColor is defined %}style="background-color: {{ data.style.buttonBackgroundColor }}; {% if data.style.buttonTextColor is defined %}color: {{ data.style.buttonTextColor }}; {% endif %}{% if data.style.buttonBorderColor is defined %}border-color: {{ data.style.buttonBorderColor }}; {% endif %}{% if data.style.buttonBorderRadius is defined %}border-radius: {{ data.style.buttonBorderRadius }}px; {% endif %}"{% endif %}>
                            {{ data.ctaText }}
                        </a>
                    {% endif %}
                </div>
            </div>
            
            {% if data.layout is defined and data.layout == 'text-left' and data.imageUrl is defined and data.imageUrl %}
                <div class="col-lg-6">
                    <div class="hero-media">
                        <img src="{{ data.imageUrl }}" alt="{{ data.title is defined ? data.title : '' }}">
                    </div>
                </div>
            {% endif %}
        </div>
        
        {% if data.formTitle is defined and data.formTitle %}
            <div class="row justify-content-center mt-8">
                <div class="col-md-8 col-lg-6">
                    <div class="lead-form">
                        <h3 class="lead-form-title mb-4">{{ data.formTitle }}</h3>
                        <form method="POST" action="{{ path('app_contact') }}" data-turbo="false">
                            <div class="mb-3">
                                <input type="text" class="form-control" placeholder="Your Name" required>
                            </div>
                            <div class="mb-3">
                                <input type="email" class="form-control" placeholder="Your Email" required>
                            </div>
                            <div class="mb-3">
                                <input type="tel" class="form-control" placeholder="Your Phone">
                            </div>
                            <div class="mb-3">
                                <textarea class="form-control" rows="4" placeholder="Your Message" required></textarea>
                            </div>
                            <button type="submit" class="btn btn-primary w-100">Send Message</button>
                        </form>
                    </div>
                </div>
            </div>
        {% endif %}
    </div>
</section>
