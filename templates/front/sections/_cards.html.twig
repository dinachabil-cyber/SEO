{% import 'front/sections/_macros.html.twig' as macros %}
<section class="{{ macros.section_class('section cards-section', data) }}" {% if data.backgroundColor is defined %}style="background-color: {{ data.backgroundColor }}; {% if data.paddingTop is defined %}padding-top: {{ data.paddingTop }}px;{% endif %} {% if data.paddingBottom is defined %}padding-bottom: {{ data.paddingBottom }}px;{% endif %} {% if data.marginTop is defined %}margin-top: {{ data.marginTop }}px;{% endif %} {% if data.marginBottom is defined %}margin-bottom: {{ data.marginBottom }}px;{% endif %}" {% elseif data.style is defined and data.style.backgroundColor is defined %}style="background-color: {{ data.style.backgroundColor }}; {% if data.style.paddingTop is defined %}padding-top: {{ data.style.paddingTop }}px;{% endif %} {% if data.style.paddingBottom is defined %}padding-bottom: {{ data.style.paddingBottom }}px;{% endif %} {% if data.style.marginTop is defined %}margin-top: {{ data.style.marginTop }}px;{% endif %} {% if data.style.marginBottom is defined %}margin-bottom: {{ data.style.marginBottom }}px;{% endif %}"{% endif %}>
    <div class="container">
        {% if data.sectionTitle is defined and data.sectionTitle %}
            <div class="text-center mb-5 {{ macros.text_align_class(data) }}">
                {% set title_style = '' %}
                {% if data.titleColor is defined %}{% set title_style = data.titleColor %}{% elseif data.style is defined and data.style.titleColor is defined %}{% set title_style = data.style.titleColor %}{% endif %}
                <h2{% if title_style %} style="color: {{ title_style }}"{% endif %}>{{ data.sectionTitle }}</h2>
            </div>
        {% endif %}
        
        <div class="row g-4 {% if data.cardLayout is defined %}{{ data.cardLayout }}{% elseif data.style is defined and data.style.cardLayout is defined %}{{ data.style.cardLayout }}{% else %}row-cols-1 row-cols-md-3{% endif %}">
            {% set cardsToRender = [] %}
            {% for c in (data.cards ?? []) %}
                {% if (c.title is defined and c.title) or (c.description is defined and c.description) or (c.linkUrl is defined and c.linkUrl) or (c.imageUrl is defined and c.imageUrl) %}
                    {% set cardsToRender = cardsToRender|merge([c]) %}
                {% endif %}
            {% endfor %}

            {% for card in cardsToRender %}
                <div class="col">
                    {% set card_style = '' %}
                    {% if data.cardBackgroundColor is defined or data.style is defined and data.style.cardBackgroundColor is defined %}
                        {% set card_bg = data.cardBackgroundColor is defined ? data.cardBackgroundColor : data.style.cardBackgroundColor %}
                        {% set card_border = data.cardBorderColor is defined ? data.cardBorderColor : (data.style is defined ? data.style.cardBorderColor : '') %}
                        {% set card_radius = data.cardBorderRadius is defined ? data.cardBorderRadius : (data.style is defined ? data.style.cardBorderRadius : '') %}
                        {% set card_shadow = data.cardShadow is defined ? data.cardShadow : (data.style is defined ? data.style.cardShadow : '') %}
                        {% set card_style = 'background-color: ' ~ card_bg ~ '; ' %}
                        {% if card_border %}{% set card_style = card_style ~ 'border-color: ' ~ card_border ~ '; ' %}{% endif %}
                        {% if card_radius %}{% set card_style = card_style ~ 'border-radius: ' ~ card_radius ~ 'px; ' %}{% endif %}
                        {% if card_shadow %}{% set card_style = card_style ~ 'box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1); ' %}{% endif %}
                    {% endif %}
                    
                    <div class="x-card h-100 {% if data.cardStyle is defined %}{{ data.cardStyle }}{% elseif data.style is defined and data.style.cardStyle is defined %}{{ data.style.cardStyle }}{% endif %}" {% if card_style %}style="{{ card_style|trim('; ') }}"{% endif %}>
                        {% if card.imageUrl is defined and card.imageUrl %}
                            {% set card_img_style = macros.card_image_style(data) %}
                            {% set card_img_classes = macros.card_image_classes(data) %}
                            <div class="card-img-container overflow-hidden">
                                <img src="{{ card.imageUrl }}" alt="{{ card.title }}" class="img-fluid w-100 {{ card_img_classes }}" style="{{ card_img_style }}">
                            </div>
                        {% endif %}
                        <div class="p-4">
                            {% set card_title_color = '' %}
                            {% if data.cardTitleColor is defined %}{% set card_title_color = data.cardTitleColor %}{% elseif data.style is defined and data.style.cardTitleColor is defined %}{% set card_title_color = data.style.cardTitleColor %}{% endif %}
                            <h3 class="mb-3 {{ macros.text_align_class(data) }}"{% if card_title_color %} style="color: {{ card_title_color }}"{% endif %}>{{ card.title }}</h3>
                            
                            {% set card_text_color_val = '' %}
                            {% if data.cardTextColor is defined %}{% set card_text_color_val = data.cardTextColor %}{% elseif data.style is defined and data.style.cardTextColor is defined %}{% set card_text_color_val = data.style.cardTextColor %}{% endif %}
                            <p class="mb-4 {{ macros.text_align_class(data) }}{% if data.cardTextColor is not defined and (data.style is not defined or data.style.cardTextColor is not defined) %} text-muted{% endif %}"{% if data.cardTextColor is defined %} style="color: {{ data.cardTextColor }}"{% elseif data.style is defined and data.style.cardTextColor is defined %} style="color: {{ card_text_color_val }}"{% endif %}>{{ card.description }}</p>
                            
                            {% if card.linkUrl is defined and card.linkUrl %}
                                {% set btn_style = macros.button_style_string(data) %}
                                <a href="{{ card.linkUrl }}" class="{{ macros.button_class_string(data) }}" {% if btn_style %}style="{{ btn_style }}"{% endif %}>
                                    Learn More
                                </a>
                            {% endif %}
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
</section>