<section class="section {% if data.backgroundColor is defined or (data.style is defined and data.style.backgroundColor is defined) %}custom-bg{% endif %}" {% if data.backgroundColor is defined %}style="background-color: {{ data.backgroundColor }}; {% if data.paddingTop is defined %}padding-top: {{ data.paddingTop }}px;{% endif %} {% if data.paddingBottom is defined %}padding-bottom: {{ data.paddingBottom }}px;{% endif %} {% if data.marginTop is defined %}margin-top: {{ data.marginTop }}px;{% endif %} {% if data.marginBottom is defined %}margin-bottom: {{ data.marginBottom }}px;{% endif %}" {% elseif data.style is defined and data.style.backgroundColor is defined %}style="background-color: {{ data.style.backgroundColor }}; {% if data.style.paddingTop is defined %}padding-top: {{ data.style.paddingTop }}px;{% endif %} {% if data.style.paddingBottom is defined %}padding-bottom: {{ data.style.paddingBottom }}px;{% endif %} {% if data.style.marginTop is defined %}margin-top: {{ data.style.marginTop }}px;{% endif %} {% if data.style.marginBottom is defined %}margin-bottom: {{ data.style.marginBottom }}px;{% endif %}"{% endif %}>
    <div class="container">
        {% if data.sectionTitle %}
            <div class="text-center mb-5 {% if data.textAlignment is defined %}text-{{ data.textAlignment }}{% elseif data.style is defined and data.style.textAlignment is defined %}text-{{ data.style.textAlignment }}{% endif %}">
                <h2 {% if data.titleColor is defined %}style="color: {{ data.titleColor }}"{% elseif data.style is defined and data.style.titleColor is defined %}style="color: {{ data.style.titleColor }}"{% endif %}>{{ data.sectionTitle }}</h2>
            </div>
        {% endif %}
        
        <div class="{% if data.cardLayout is defined %}{{ data.cardLayout }}{% elseif data.style is defined and data.style.cardLayout is defined %}{{ data.style.cardLayout }}{% else %}grid-3{% endif %}">
            {% for card in data.cards %}
                <div class="x-card {% if data.cardStyle is defined %}{{ data.cardStyle }}{% elseif data.style is defined and data.style.cardStyle is defined %}{{ data.style.cardStyle }}{% endif %}" {% if data.cardBackgroundColor is defined %}style="background-color: {{ data.cardBackgroundColor }}; {% if data.cardBorderColor is defined %}border-color: {{ data.cardBorderColor }};{% endif %} {% if data.cardBorderRadius is defined %}border-radius: {{ data.cardBorderRadius }}px;{% endif %} {% if data.cardShadow is defined %}box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);{% endif %}" {% elseif data.style is defined and data.style.cardBackgroundColor is defined %}style="background-color: {{ data.style.cardBackgroundColor }}; {% if data.style.cardBorderColor is defined %}border-color: {{ data.style.cardBorderColor }};{% endif %} {% if data.style.cardBorderRadius is defined %}border-radius: {{ data.style.cardBorderRadius }}px;{% endif %} {% if data.style.cardShadow is defined %}box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);{% endif %}"{% endif %}>
                    {% if card.imageUrl %}
                        <img src="{{ card.imageUrl }}" alt="{{ card.title }}" class="img-fluid mb-4 {% if data.cardStyle is defined and data.cardStyle == 'rounded' %}rounded{% elseif data.style is defined and data.style.cardStyle is defined and data.style.cardStyle == 'rounded' %}rounded{% endif %} {% if data.cardStyle is defined and data.cardStyle == 'oval' %}rounded-circle{% elseif data.style is defined and data.style.cardStyle is defined and data.style.cardStyle == 'oval' %}rounded-circle{% endif %} {% if data.cardStyle is defined and data.cardStyle == 'square' %}rounded-0{% elseif data.style is defined and data.style.cardStyle is defined and data.style.cardStyle == 'square' %}rounded-0{% endif %}">
                    {% endif %}
                    <h3 class="mb-2 {% if data.textAlignment is defined %}text-{{ data.textAlignment }}{% elseif data.style is defined and data.style.textAlignment is defined %}text-{{ data.style.textAlignment }}{% endif %}" {% if data.cardTitleColor is defined %}style="color: {{ data.cardTitleColor }}"{% elseif data.style is defined and data.style.cardTitleColor is defined %}style="color: {{ data.style.cardTitleColor }}"{% endif %}>{{ card.title }}</h3>
                    <p class="mb-4 {% if data.textAlignment is defined %}text-{{ data.textAlignment }}{% elseif data.style is defined and data.style.textAlignment is defined %}text-{{ data.style.textAlignment }}{% endif %} {% if data.cardTextColor is not defined and (data.style is not defined or data.style.cardTextColor is not defined) %}text-muted{% endif %}" {% if data.cardTextColor is defined %}style="color: {{ data.cardTextColor }}"{% elseif data.style is defined and data.style.cardTextColor is defined %}style="color: {{ data.style.cardTextColor }}"{% endif %}>{{ card.description }}</p>
                    {% if card.linkUrl %}
                        <a href="{{ card.linkUrl }}" class="btn btn-{% if data.buttonStyle is defined %}{{ data.buttonStyle }}{% elseif data.style is defined and data.style.buttonStyle is defined %}{{ data.style.buttonStyle }}{% else %}primary{% endif %}" {% if data.buttonBackgroundColor is defined %}style="background-color: {{ data.buttonBackgroundColor }}; {% if data.buttonTextColor is defined %}color: {{ data.buttonTextColor }};{% endif %} {% if data.buttonBorderColor is defined %}border-color: {{ data.buttonBorderColor }};{% endif %} {% if data.buttonBorderRadius is defined %}border-radius: {{ data.buttonBorderRadius }}px;{% endif %}" {% elseif data.style is defined and data.style.buttonBackgroundColor is defined %}style="background-color: {{ data.style.buttonBackgroundColor }}; {% if data.style.buttonTextColor is defined %}color: {{ data.style.buttonTextColor }};{% endif %} {% if data.style.buttonBorderColor is defined %}border-color: {{ data.style.buttonBorderColor }};{% endif %} {% if data.style.buttonBorderRadius is defined %}border-radius: {{ data.style.buttonBorderRadius }}px;{% endif %}"{% endif %}>
                            Learn More
                        </a>
                    {% endif %}
                </div>
            {% endfor %}
        </div>
    </div>
</section>
