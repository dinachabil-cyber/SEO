{% extends 'base.html.twig' %}

{% block title %}Set New Password - Admin{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="bi bi-key"></i> Set New Password</h1>
        <a href="{{ path('admin_password_reset_show', {'id': request.id}) }}" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Back to Request
        </a>
    </div>

    <div class="card">
        <div class="card-header">
            <h5 class="mb-0">Set new password for: <strong>{{ user.name }}</strong></h5>
            <small class="text-muted">Processing request #{{ request.id }}</small>
        </div>
        <div class="card-body">
            {{ form_start(form) }}
            
            {% if form_errors(form) %}
                <div class="alert alert-danger">
                    {{ form_errors(form) }}
                </div>
            {% endif %}

            <div class="mb-3">
                {{ form_label(form.newPassword.first) }}
                {{ form_widget(form.newPassword.first, {'attr': {'class': 'form-control'}}) }}
                <div class="form-error">
                    {{ form_errors(form.newPassword.first) }}
                </div>
            </div>

            <div class="mb-3">
                {{ form_label(form.newPassword.second) }}
                {{ form_widget(form.newPassword.second, {'attr': {'class': 'form-control'}}) }}
                <div class="form-error">
                    {{ form_errors(form.newPassword.second) }}
                </div>
            </div>

            <div class="mt-3">
                <button type="submit" class="btn btn-warning">
                    <i class="bi bi-key"></i> Reset Password
                </button>
                <a href="{{ path('admin_password_reset_show', {'id': request.id}) }}" class="btn btn-secondary">Cancel</a>
            </div>

            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
