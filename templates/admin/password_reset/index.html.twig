{% extends 'base.html.twig' %}

{% block title %}Password Reset Requests - Admin{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="bi bi-key"></i> Password Reset Requests</h1>
        <a href="{{ path('app_dashboard') }}" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Back to Dashboard
        </a>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endfor %}

    {% for message in app.flashes('error') %}
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endfor %}

    <div class="card">
        <div class="card-body">
            {% if requests|length > 0 %}
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>User</th>
                                <th>Requested At</th>
                                <th>Status</th>
                                <th>Processed By</th>
                                <th>Processed At</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for request in requests %}
                                <tr>
                                    <td>{{ request.id }}</td>
                                    <td>
                                        <strong>{{ request.user.name }}</strong>
                                    </td>
                                    <td>{{ request.requestedAt ? request.requestedAt|date('Y-m-d H:i') : 'N/A' }}</td>
                                    <td>
                                        {% if request.status == 'pending' %}
                                            <span class="badge bg-warning">Pending</span>
                                        {% elseif request.status == 'approved' %}
                                            <span class="badge bg-info">Approved</span>
                                        {% elseif request.status == 'rejected' %}
                                            <span class="badge bg-danger">Rejected</span>
                                        {% elseif request.status == 'completed' %}
                                            <span class="badge bg-success">Completed</span>
                                        {% endif %}
                                    </td>
                                    <td>{{ request.processedBy ? request.processedBy.name : '-' }}</td>
                                    <td>{{ request.processedAt ? request.processedAt|date('Y-m-d H:i') : '-' }}</td>
                                    <td>
                                        <a href="{{ path('admin_password_reset_show', {'id': request.id}) }}" class="btn btn-sm btn-primary">
                                            <i class="bi bi-eye"></i> View
                                        </a>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% else %}
                <p class="text-center text-muted mb-0">No password reset requests.</p>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
