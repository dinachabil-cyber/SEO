{% extends 'base.html.twig' %}

{% block title %}Edit User - Admin{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="bi bi-pencil"></i> Edit User</h1>
        <a href="{{ path('admin_user_show', {'id': user.id}) }}" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Back to User
        </a>
    </div>

    <div class="card">
        <div class="card-body">
            {{ form_start(form) }}
            {{ form_widget(form) }}
            <div class="mt-3">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check"></i> Save Changes
                </button>
                <a href="{{ path('admin_user_show', {'id': user.id}) }}" class="btn btn-secondary">Cancel</a>
            </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
