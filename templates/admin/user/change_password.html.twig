{% extends 'base.html.twig' %}

{% block title %}Change Password - Admin{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mb-0"><i class="bi bi-key"></i> Change Password</h1>
        {% include 'admin/partials/_back_button.html.twig' %}
    </div>

    <div class="card">
        <div class="card-header">
            <h5 class="mb-0">Change password for: <strong>{{ user.name }}</strong></h5>
        </div>
        <div class="card-body">
            {{ form_start(form) }}
            
            {% if form_errors(form) %}
                <div class="alert alert-danger">
                    {{ form_errors(form) }}
                </div>
            {% endif %}

            <div class="mb-3">
                {{ form_label(form.newPassword.first) }}
                {{ form_widget(form.newPassword.first, {'attr': {'class': 'form-control'}}) }}
                <div class="form-error">
                    {{ form_errors(form.newPassword.first) }}
                </div>
            </div>

            <div class="mb-3">
                {{ form_label(form.newPassword.second) }}
                {{ form_widget(form.newPassword.second, {'attr': {'class': 'form-control'}}) }}
                <div class="form-error">
                    {{ form_errors(form.newPassword.second) }}
                </div>
            </div>

            <div class="mt-3">
                <button type="submit" class="btn btn-warning">
                    <i class="bi bi-key"></i> Change Password
                </button>
                <a href="{{ path('admin_user_show', {'id': user.id}) }}" class="btn btn-secondary">Cancel</a>
            </div>

            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
