{% extends 'base.html.twig' %}

{% block title %}User Details - Admin{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mb-0"><i class="bi bi-person"></i> User Details</h1>
        {% include 'admin/partials/_back_button.html.twig' %}
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endfor %}

    {% for message in app.flashes('error') %}
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endfor %}

    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0">{{ user.name }}</h5>
        </div>
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3">ID</dt>
                <dd class="col-sm-9">{{ user.id }}</dd>

                <dt class="col-sm-3">Username</dt>
                <dd class="col-sm-9">{{ user.name }}</dd>

                <dt class="col-sm-3">Roles</dt>
                <dd class="col-sm-9">
                    {% for role in user.roles %}
                        <span class="badge bg-secondary">{{ role }}</span>
                    {% endfor %}
                </dd>

                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9">
                    {% if user.isEnabled %}
                        <span class="badge bg-success">Enabled</span>
                    {% else %}
                        <span class="badge bg-danger">Disabled</span>
                    {% endif %}
                </dd>

                <dt class="col-sm-3">Created At</dt>
                <dd class="col-sm-9">{{ user.createdAt ? user.createdAt|date('Y-m-d H:i:s') : 'N/A' }}</dd>

                <dt class="col-sm-3">Updated At</dt>
                <dd class="col-sm-9">{{ user.updatedAt ? user.updatedAt|date('Y-m-d H:i:s') : 'N/A' }}</dd>
            </dl>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0">Actions</h5>
        </div>
        <div class="card-body">
            <div class="btn-group" role="group">
                <a href="{{ path('admin_user_edit', {'id': user.id}) }}" class="btn btn-primary">
                    <i class="bi bi-pencil"></i> Edit User
                </a>
                <a href="{{ path('admin_user_change_password', {'id': user.id}) }}" class="btn btn-warning">
                    <i class="bi bi-key"></i> Change Password
                </a>
            </div>

            <hr>

            <h6>Account Status</h6>
            {% if user.isEnabled %}
                <form method="post" action="{{ path('admin_user_disable', {'id': user.id}) }}" class="d-inline">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('disable' ~ user.id) }}">
                    <button type="submit" class="btn btn-danger" onclick="return confirm('Are you sure you want to disable this user account?')">
                        <i class="bi bi-x-circle"></i> Disable Account
                    </button>
                </form>
            {% else %}
                <form method="post" action="{{ path('admin_user_enable', {'id': user.id}) }}" class="d-inline">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('enable' ~ user.id) }}">
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-check-circle"></i> Enable Account
                    </button>
                </form>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
