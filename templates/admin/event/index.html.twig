{% extends 'base.html.twig' %}

{% block title %}Events - Admin{% endblock %}

{% block body %}
<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Events</h1>
        <a href="{{ path('admin_event_new') }}" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> New Event
        </a>
    </div>

    {% if sites|length > 1 %}
    <div class="mb-3">
        <form method="get" class="d-inline-block">
            <select name="site" class="form-select" onchange="this.form.submit()">
                <option value="">All Sites</option>
                {% for site in sites %}
                    <option value="{{ site.id }}" {% if selectedSiteId == site.id %}selected{% endif %}>
                        {{ site.domain }}
                    </option>
                {% endfor %}
            </select>
        </form>
    </div>
    {% endif %}

    {% if events|length > 0 %}
    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Start Date</th>
                    <th>End Date</th>
                    <th>Location</th>
                    <th>Site</th>
                    <th>Assigned Users</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for event in events %}
                <tr>
                    <td>
                        <a href="{{ path('calendar_show', {slug: event.slug}) }}" target="_blank">
                            {{ event.title }}
                        </a>
                    </td>
                    <td>{{ event.startAt|date('Y-m-d H:i') }}</td>
                    <td>{{ event.endAt|date('Y-m-d H:i') }}</td>
                    <td>{{ event.location ?: '-' }}</td>
                    <td>{{ event.site ? event.site.domain : '-' }}</td>
                    <td>
                        {% if event.assignedUsers|length > 0 %}
                            {% for user in event.assignedUsers %}
                                <span class="badge bg-info">{{ user.name }}</span>
                            {% endfor %}
                        {% else %}
                            -
                        {% endif %}
                    </td>
                    <td>
                        <a href="{{ path('admin_event_edit', {id: event.id}) }}" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <a href="{{ path('admin_event_duplicate', {id: event.id}) }}" class="btn btn-sm btn-outline-secondary">
                            <i class="bi bi-copy"></i>
                        </a>
                        <form method="post" action="{{ path('admin_event_delete', {id: event.id}) }}" class="d-inline">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ event.id) }}">
                            <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Are you sure you want to delete this event?')">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    {% else %}
    <p class="text-muted">No events found.</p>
    {% endif %}
</div>
{% endblock %}