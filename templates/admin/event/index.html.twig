{% extends 'base.html.twig' %}

{% block title %}Events - Admin{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="mb-1"><i class="bi bi-calendar-event"></i> Events</h1>
            <p class="text-muted mb-0">Manage your calendar events</p>
        </div>
        <a href="{{ path('admin_event_new') }}" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> New Event
        </a>
    </div>

    {% if sites|length > 1 %}
    <div class="mb-4">
        <form method="get" class="d-inline-block">
            <div class="input-group">
                <span class="input-group-text bg-white">
                    <i class="bi bi-globe"></i>
                </span>
                <select name="site" class="form-select" onchange="this.form.submit()" style="max-width: 250px;">
                    <option value="">All Sites</option>
                    {% for site in sites %}
                        <option value="{{ site.id }}" {% if selectedSiteId == site.id %}selected{% endif %}>
                            {{ site.domain }}
                        </option>
                    {% endfor %}
                </select>
            </div>
        </form>
    </div>
    {% endif %}

    {% if events|length > 0 %}
    <div class="row g-4">
        {% for event in events %}
        <div class="col-12">
            <div class="card x-card h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div class="flex-grow-1">
                            <h5 class="mb-2">
                                <a href="{{ path('calendar_show', {slug: event.slug}) }}" target="_blank" class="text-decoration-none text-dark">
                                    {{ event.title }}
                                </a>
                            </h5>
                            <div class="d-flex flex-wrap gap-3 mb-3">
                                <div class="d-flex align-items-center text-muted">
                                    <i class="bi bi-clock me-2"></i>
                                    <small>{{ event.startAt|date('M d, Y H:i') }} - {{ event.endAt|date('H:i') }}</small>
                                </div>
                                {% if event.location %}
                                <div class="d-flex align-items-center text-muted">
                                    <i class="bi bi-geo-alt me-2"></i>
                                    <small>{{ event.location }}</small>
                                </div>
                                {% endif %}
                                {% if event.site %}
                                <div class="d-flex align-items-center text-muted">
                                    <i class="bi bi-globe me-2"></i>
                                    <small>{{ event.site.domain }}</small>
                                </div>
                                {% endif %}
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                {% if event.assignedUsers|length > 0 %}
                                    {% for user in event.assignedUsers %}
                                        <span class="badge bg-primary bg-opacity-10 text-primary border border-primary">
                                            <i class="bi bi-person me-1"></i>{{ user.name }}
                                        </span>
                                    {% endfor %}
                                {% else %}
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary">
                                        <i class="bi bi-person-x me-1"></i>No users assigned
                                    </span>
                                {% endif %}
                            </div>
                        </div>
                        <div class="d-flex gap-2 ms-3">
                            <a href="{{ path('admin_event_edit', {id: event.id}) }}" class="btn btn-sm btn-outline-primary" title="Edit">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <a href="{{ path('admin_event_duplicate', {id: event.id}) }}" class="btn btn-sm btn-outline-secondary" title="Duplicate">
                                <i class="bi bi-copy"></i>
                            </a>
                            <form method="post" action="{{ path('admin_event_delete', {id: event.id}) }}" class="d-inline">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ event.id) }}">
                                <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Are you sure you want to delete this event?')" title="Delete">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        {% endfor %}
    </div>
    {% else %}
    <div class="card x-card">
        <div class="card-body text-center py-5">
            <i class="bi bi-calendar-x display-1 text-muted"></i>
            <h4 class="mt-3">No Events Found</h4>
            <p class="text-muted mb-4">Get started by creating your first event.</p>
            <a href="{{ path('admin_event_new') }}" class="btn btn-primary">
                <i class="bi bi-plus-lg me-2"></i>Create Event
            </a>
        </div>
    </div>
    {% endif %}
</div>
{% endblock %}