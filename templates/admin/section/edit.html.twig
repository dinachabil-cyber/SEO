{% extends 'base.html.twig' %}

{% block title %}Edit Section{% endblock %}

{% block body %}
<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <div class="d-flex justify-content-between align-items-center">
                        <h3 class="card-title mb-0">Edit Section</h3>
                        {% include 'admin/partials/_back_button.html.twig' %}
                    </div>
                </div>
                
                <div class="card-body">
                    {% if section.referenceSection %}
                        <div class="alert alert-warning mb-4">
                            <i class="bi bi-exclamation-triangle me-2"></i>
                            This section is linked to the <strong>{{ section.referenceSection.name }}</strong> reference.
                            Editing this section will edit the reference, which affects all pages using it.
                        </div>
                    {% endif %}

                    {{ form_start(form, {attr: {class: 'needs-validation', 'data-turbo': 'false', onsubmit: 'updateHeroFieldsJson(); updateFieldsJson(); return true;'}}) }}
                    
                    {% include 'admin/section/_form.html.twig' %}
                    
                    <div class="d-flex justify-content-end gap-2">
                        <a href="{{ path('app_page_builder', {siteId: site.id, pageId: page.id}) }}" class="btn btn-outline-secondary">
                            Cancel
                        </a>
                        <a href="{{ path('app_front_page', {slug: page.slug}) }}" class="btn btn-outline-info">
                            <i class="bi bi-eye me-1"></i> Preview
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-circle me-1"></i> Save Changes
                        </button>
                    </div>
                    
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
