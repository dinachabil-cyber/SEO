{% extends 'base.html.twig' %}

{% block title %}Edit Section{% endblock %}

{% block body %}
<script>
function beforeSubmitSectionForm() {
    if (typeof updateHeroFieldsJson === 'function') {
        updateHeroFieldsJson();
    }
    if (typeof updateFieldsJson === 'function') {
        updateFieldsJson();
    }
    return true;
}
</script>
<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <div class="d-flex justify-content-between align-items-center">
                        <h3 class="card-title mb-0">Edit Section</h3>
                        {% include 'admin/partials/_back_button.html.twig' %}
                    </div>
                </div>
                
                <div class="card-body">
                    {% if section.referenceSection %}
                        <div class="alert alert-info mb-4">
                            <i class="bi bi-info-circle me-2"></i>
                            This section was imported from the <strong>{{ section.referenceSection.name }}</strong> reference.
                            You can now edit it independently without affecting other pages.
                        </div>
                    {% endif %}

                    {{ form_start(form, {attr: {class: 'needs-validation', 'data-turbo': 'false', 'novalidate': 'novalidate', onsubmit: 'return beforeSubmitSectionForm()'}}) }}
                    
                    {% include 'admin/section/_form.html.twig' %}
                    
                    <div class="d-flex justify-content-end gap-2">
                        <a href="{{ path('app_page_builder', {siteId: site.id, pageId: page.id}) }}" class="btn btn-outline-secondary">
                            Cancel
                        </a>
                        <a href="{{ path('app_preview_page', {'id': page.id}) }}" class="btn btn-outline-info">
                            <i class="bi bi-eye me-1"></i> Preview
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-circle me-1"></i> Save Changes
                        </button>
                    </div>
                    
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
