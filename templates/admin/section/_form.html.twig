{{ form_row(form.type) }}


{% if form.data is defined %}
    <div class="section-data-fields">
        {% set dataForm = form.data %}
        
        {% if form.vars.value.type == 'header' %}
            <ul class="nav nav-tabs" id="headerSectionTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="content-tab" data-bs-toggle="tab" data-bs-target="#header-content" type="button" role="tab" aria-controls="header-content" aria-selected="true">Content</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="style-tab" data-bs-toggle="tab" data-bs-target="#header-style" type="button" role="tab" aria-controls="header-style" aria-selected="false">Style</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="buttons-tab" data-bs-toggle="tab" data-bs-target="#header-buttons" type="button" role="tab" aria-controls="header-buttons" aria-selected="false">Buttons</button>
                </li>
            </ul>
            <div class="tab-content p-3 border border-top-0" id="headerSectionTabsContent">
                <div class="tab-pane fade show active" id="header-content" role="tabpanel" aria-labelledby="content-tab">
                    {{ form_row(dataForm.brandText) }}
                    {{ form_row(dataForm.logoUrl) }}
                    {{ form_row(dataForm.menuItems) }}
                    {{ form_row(dataForm.ctaText) }}
                    {{ form_row(dataForm.ctaUrl) }}
                </div>
                <div class="tab-pane fade" id="header-style" role="tabpanel" aria-labelledby="style-tab">
                    {{ form_row(dataForm.backgroundColor) }}
                    {{ form_row(dataForm.textColor) }}
                    {{ form_row(dataForm.paddingTop) }}
                    {{ form_row(dataForm.paddingBottom) }}
                    {{ form_row(dataForm.marginTop) }}
                    {{ form_row(dataForm.marginBottom) }}
                </div>
                <div class="tab-pane fade" id="header-buttons" role="tabpanel" aria-labelledby="buttons-tab">
                    {{ form_row(dataForm.buttonBackgroundColor) }}
                    {{ form_row(dataForm.buttonTextColor) }}
                    {{ form_row(dataForm.buttonBorderColor) }}
                    {{ form_row(dataForm.buttonBorderRadius) }}
                    {{ form_row(dataForm.buttonStyle) }}
                </div>
            </div>
            
        {% elseif form.vars.value.type == 'hero' %}
            <ul class="nav nav-tabs" id="heroSectionTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="content-tab" data-bs-toggle="tab" data-bs-target="#hero-content" type="button" role="tab" aria-controls="hero-content" aria-selected="true">Content</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="media-tab" data-bs-toggle="tab" data-bs-target="#hero-media" type="button" role="tab" aria-controls="hero-media" aria-selected="false">Media</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="layout-tab" data-bs-toggle="tab" data-bs-target="#hero-layout" type="button" role="tab" aria-controls="hero-layout" aria-selected="false">Layout</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="style-tab" data-bs-toggle="tab" data-bs-target="#hero-style" type="button" role="tab" aria-controls="hero-style" aria-selected="false">Style</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="form-fields-tab" data-bs-toggle="tab" data-bs-target="#hero-form-fields" type="button" role="tab" aria-controls="hero-form-fields" aria-selected="false">Form Fields</button>
                </li>
            </ul>
            <div class="tab-content p-3 border border-top-0" id="heroSectionTabsContent">
                
                {# Content Tab #}
                <div class="tab-pane fade" id="hero-content" role="tabpanel" aria-labelledby="content-tab">
                    <div class="row">
                        <div class="col-md-6">
                            {{ form_row(dataForm.hero_title) }}
                        </div>
                        <div class="col-md-6">
                            {{ form_row(dataForm.badge_text) }}
                        </div>
                    </div>
                    {{ form_row(dataForm.hero_subtitle) }}
                    {{ form_row(dataForm.description) }}
                </div>
                
                {# Media Tab #}
                <div class="tab-pane fade" id="hero-media" role="tabpanel" aria-labelledby="media-tab">
                    {{ form_row(dataForm.show_image) }}
                    <div class="alert alert-info small">
                        <i class="bi bi-info-circle me-1"></i>
                        Toggle "Show Image" to display or hide the hero image.
                    </div>
                    {{ form_row(dataForm.hero_image_url) }}
                    {{ form_row(dataForm.mobile_image_url) }}
                    {{ form_row(dataForm.image_alt_text) }}
                </div>
                
                {# Layout Tab #}
                <div class="tab-pane fade" id="hero-layout" role="tabpanel" aria-labelledby="layout-tab">
                    <div class="alert alert-secondary small mb-3">
                        <i class="bi bi-info-circle me-1"></i>
                        <strong>Layout:</strong> controls where things sit. Use "Layout Type" to put the <u>form on the left/right of the image</u>, center them, or show the form only. The hero title always stays above the image.
                    </div>
                    {{ form_row(dataForm.layout_type) }}
                    {{ form_row(dataForm.text_alignment) }}
                    <div class="row">
                        <div class="col-md-6">
                            {{ form_row(dataForm.content_width) }}
                        </div>
                        <div class="col-md-6">
                            {{ form_row(dataForm.section_height) }}
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            {{ form_row(dataForm.vertical_alignment) }}
                        </div>
                        <div class="col-md-6">
                            {{ form_row(dataForm.column_gap) }}
                        </div>
                    </div>
                    <div class="alert alert-info small">
                        <i class="bi bi-info-circle me-1"></i>
                        Select "Form Only" layout to hide the image block. Select "Form Right, Image Left" for split form layout.
                    </div>
                </div>
                
                {# Style Tab #}
                <div class="tab-pane fade" id="hero-style" role="tabpanel" aria-labelledby="style-tab">
                    <div class="alert alert-secondary small mb-3">
                        <i class="bi bi-info-circle me-1"></i>
                        <strong>Style:</strong> controls <u>colors and spacing</u> of the hero section (background, title/text colors, padding/margins). This is not the form's submit button.
                    </div>
                    {{ form_row(dataForm.background_color) }}
                    <div class="row">
                        <div class="col-md-6">
                            {{ form_row(dataForm.hero_text_color) }}
                        </div>
                    </div>
                    <hr class="my-4">
                    <h6 class="text-muted mb-3">Spacing</h6>
                    <div class="row">
                        <div class="col-md-6">
                            {{ form_row(dataForm.paddingTop) }}
                        </div>
                        <div class="col-md-6">
                            {{ form_row(dataForm.paddingBottom) }}
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            {{ form_row(dataForm.marginTop) }}
                        </div>
                        <div class="col-md-6">
                            {{ form_row(dataForm.marginBottom) }}
                        </div>
                    </div>
                </div>

                {# Form Fields Tab #}
                <div class="tab-pane fade" id="hero-form-fields" role="tabpanel" aria-labelledby="form-fields-tab">
                    <div class="alert alert-info small">
                        <i class="bi bi-info-circle me-1"></i>
                        Build the form fields below, then set the form title and submit button styling.
                    </div>
                    {{ form_row(dataForm.hero_form_fields) }}
                    {% include 'admin/section/partials/_hero_fields_builder.html.twig' with {
                        'hero_form_fields_json': dataForm.hero_form_fields.vars.value|default('[]'),
                        'symfony_input_id': dataForm.hero_form_fields.vars.id,
                        'field_types': {
                            'text': 'Text Input',
                            'email': 'Email',
                            'tel': 'Phone',
                            'textarea': 'Text Area',
                            'select': 'Dropdown',
                            'checkbox': 'Checkbox',
                            'radio': 'Radio Buttons',
                            'number': 'Number',
                            'date': 'Date',
                            'color': 'Color',
                            'url': 'URL',
                            'image': 'Image URL',
                            'hidden': 'Hidden Field'
                        }
                    } %}
                    <hr class="my-4">
                    <h6 class="text-muted mb-3">Form Submit Button ("Send Message")</h6>
                    <div class="alert alert-secondary small mb-3">
                        <i class="bi bi-info-circle me-1"></i>
                        This is the button that <u>sends the form</u>. It is required and is added automatically — you do <u>not</u> add a button from the form fields above. Just type the label you want (e.g. "Send Message", "Get a Quote", "Subscribe") and choose its colors here.
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            {{ form_row(dataForm.form_title) }}
                        </div>
                        <div class="col-md-6">
                            {{ form_row(dataForm.submit_button_text) }}
                        </div>
                    </div>
                    {{ form_row(dataForm.form_subtitle) }}
                    <div class="row">
                        <div class="col-md-4">
                            {{ form_row(dataForm.form_title_color) }}
                        </div>
                        <div class="col-md-4">
                            {{ form_row(dataForm.form_subtitle_color) }}
                        </div>
                        <div class="col-md-4">
                            {{ form_row(dataForm.submit_button_background_color) }}
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            {{ form_row(dataForm.submit_button_text_color) }}
                        </div>
                        <div class="col-md-6">
                            {{ form_row(dataForm.submit_button_border_radius) }}
                        </div>
                    </div>
                </div>
            </div>
            
        {% elseif form.vars.value.type == 'body' %}
            {{ form_row(dataForm.content) }}
            
        {% elseif form.vars.value.type == 'image' %}
            {{ form_row(dataForm.imageUrl) }}
            {{ form_row(dataForm.alt) }}
            {{ form_row(dataForm.caption) }}
            
        {% elseif form.vars.value.type == 'cards' or form.vars.value.type == 'cards_premium' %}
            <ul class="nav nav-tabs" id="cardsSectionTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="content-tab" data-bs-toggle="tab" data-bs-target="#cards-content" type="button" role="tab" aria-controls="cards-content" aria-selected="true">Content</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="layout-tab" data-bs-toggle="tab" data-bs-target="#cards-layout" type="button" role="tab" aria-controls="cards-layout" aria-selected="false">Layout</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="style-tab" data-bs-toggle="tab" data-bs-target="#cards-style" type="button" role="tab" aria-controls="cards-style" aria-selected="false">Style</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="buttons-tab" data-bs-toggle="tab" data-bs-target="#cards-buttons" type="button" role="tab" aria-controls="cards-buttons" aria-selected="false">Buttons</button>
                </li>
            </ul>
            <div class="tab-content p-3 border border-top-0" id="cardsSectionTabsContent">
                <div class="tab-pane fade show active" id="cards-content" role="tabpanel" aria-labelledby="content-tab">
                    {{ form_row(dataForm.sectionTitle) }}

                    <div class="cards-collection" id="cards-collection" data-index="{{ dataForm.cards|length }}">
                        {% if dataForm.cards is defined and dataForm.cards|length > 0 %}
                            {% for cardForm in dataForm.cards %}
                                <div class="collection-item mb-3" data-card-index="{{ loop.index0 }}">
                                    <div class="collection-item-header d-flex justify-content-between align-items-center">
                                        <strong>Card {{ loop.index }}</strong>
                                        <button type="button" class="btn btn-sm btn-outline-danger remove-card" data-target="#card-{{ loop.index0 }}">
                                            <i class="bi bi-trash"></i> Remove
                                        </button>
                                    </div>

                                    <div class="collection-item-body">
                                        <div class="row">
                                            <div class="col-md-6">
                                                {{ form_row(cardForm.title) }}
                                            </div>
                                            <div class="col-md-6">
                                                {{ form_row(cardForm.imageUrl) }}
                                            </div>
                                        </div>

                                        {{ form_row(cardForm.description) }}

                                        <div class="row">
                                            <div class="col-md-6">
                                                {{ form_row(cardForm.linkUrl) }}
                                            </div>
                                            <div class="col-md-6">
                                                {{ form_row(cardForm.buttonText) }}
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        {% else %}
                            <p class="text-muted small">No cards added yet. Click the button below to add your first card.</p>
                        {% endif %}
                    </div>

                    <button type="button" class="btn btn-sm btn-primary mt-2" id="add-card-btn">
                        <i class="bi bi-plus-circle me-1"></i> Add Card
                    </button>

                    <div id="card-prototype-source" style="display: none;">
                        {{ form_widget(dataForm.cards.vars.prototype) }}
                    </div>

                    <script>
                        (function() {
                            const container = document.getElementById('cards-collection');
                            const addBtn = document.getElementById('add-card-btn');
                            const prototypeSource = document.getElementById('card-prototype-source');
                            if (!container || !addBtn || !prototypeSource) {
                                return;
                            }

                            // Prevent double-initialization (Turbo / re-render)
                            if (container.dataset.cardsJsBound === '1') {
                                return;
                            }
                            container.dataset.cardsJsBound = '1';


                            let nextIndex = container.dataset.index ? parseInt(container.dataset.index, 10) : 0;

                            function updateNames(containerItem, index) {
                                const inputs = containerItem.querySelectorAll('input, textarea, select');
                                inputs.forEach(function(input) {
                                    const name = input.getAttribute('name') || '';
                                    const updatedName = name.replace(/__name__/g, index.toString());
                                    input.setAttribute('name', updatedName);

                                    const id = input.getAttribute('id');
                                    if (id) {
                                        input.setAttribute('id', id.replace(/__name__/g, index.toString()));
                                    }
                                });
                            }

                            addBtn.addEventListener('click', function() {
                                const source = prototypeSource.firstElementChild.cloneNode(true);
                                updateNames(source, nextIndex);

                                source.querySelectorAll('input, textarea').forEach(function(input) {
                                    if (input.type !== 'hidden') {
                                        input.value = '';
                                        if (input.hasAttribute('required')) {
                                            input.removeAttribute('required');
                                        }
                                    }
                                });

                                source.classList.add('collection-item', 'mb-3');
                                source.setAttribute('data-card-index', nextIndex.toString());

                                const header = document.createElement('div');
                                header.className = 'collection-item-header d-flex justify-content-between align-items-center';
                                header.innerHTML = '<strong>Card ' + (nextIndex + 1) + '</strong>';

                                const removeBtn = document.createElement('button');
                                removeBtn.type = 'button';
                                removeBtn.className = 'btn btn-sm btn-outline-danger remove-card';
                                removeBtn.innerHTML = '<i class="bi bi-trash"></i> Remove';
                                removeBtn.addEventListener('click', function() {
                                    if (confirm('Remove this card?')) {
                                        source.remove();
                                    }
                                });
                                header.appendChild(removeBtn);

                                const body = document.createElement('div');
                                body.className = 'collection-item-body';
                                while (source.firstChild) {
                                    body.appendChild(source.firstChild);
                                }
                                source.insertBefore(header, body);
                                source.appendChild(body);

                                container.appendChild(source);
                                nextIndex = nextIndex + 1;
                                container.dataset.index = nextIndex.toString();

                                const prototypeInputs = prototypeSource.querySelectorAll('input, textarea, select');
                                prototypeInputs.forEach(function(input) { input.value = ''; });
                            });

                            container.querySelectorAll('.collection-item').forEach(function(item) {
                                const removeBtn = item.querySelector('.remove-card');
                                if (removeBtn && !removeBtn._cardsJsBound) {
                                    removeBtn._cardsJsBound = true;
                                    removeBtn.addEventListener('click', function() {
                                        if (confirm('Remove this card?')) {
                                            item.remove();
                                        }
                                    });
                                }
                            });
                        })();
                    </script>
                </div>

                <div class="tab-pane fade" id="cards-layout" role="tabpanel" aria-labelledby="layout-tab">
                    {{ form_row(dataForm.cardLayout) }}
                    {{ form_row(dataForm.cardStyle) }}
                    {{ form_row(dataForm.textAlignment) }}
                </div>

                <div class="tab-pane fade" id="cards-style" role="tabpanel" aria-labelledby="style-tab">
                    {{ form_row(dataForm.backgroundColor) }}
                    {{ form_row(dataForm.textColor) }}
                    {{ form_row(dataForm.titleColor) }}
                    {{ form_row(dataForm.subtitleColor) }}
                    {{ form_row(dataForm.cardBackgroundColor) }}
                    {{ form_row(dataForm.cardTitleColor) }}
                    {{ form_row(dataForm.cardTextColor) }}
                    {{ form_row(dataForm.cardBorderColor) }}
                    {{ form_row(dataForm.cardShadow) }}
                    {{ form_row(dataForm.cardBorderRadius) }}
                    {{ form_row(dataForm.paddingTop) }}
                    {{ form_row(dataForm.paddingBottom) }}
                    {{ form_row(dataForm.marginTop) }}
                    {{ form_row(dataForm.marginBottom) }}
                </div>

                <div class="tab-pane fade" id="cards-buttons" role="tabpanel" aria-labelledby="buttons-tab">
                    {{ form_row(dataForm.buttonBackgroundColor) }}
                    {{ form_row(dataForm.buttonTextColor) }}
                    {{ form_row(dataForm.buttonBorderColor) }}
                    {{ form_row(dataForm.buttonBorderRadius) }}
                    {{ form_row(dataForm.buttonStyle) }}
                </div>
            </div>

            
        {% elseif form.vars.value.type == 'faq' %}
            <ul class="nav nav-tabs" id="faqSectionTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="faq-content-tab" data-bs-toggle="tab" data-bs-target="#faq-content" type="button" role="tab" aria-controls="faq-content" aria-selected="true">Content</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="faq-style-tab" data-bs-toggle="tab" data-bs-target="#faq-style" type="button" role="tab" aria-controls="faq-style" aria-selected="false">Style</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="faq-layout-tab" data-bs-toggle="tab" data-bs-target="#faq-layout" type="button" role="tab" aria-controls="faq-layout" aria-selected="false">Layout</button>
                </li>
            </ul>
            <div class="tab-content p-3 border border-top-0" id="faqSectionTabsContent">
                <div class="tab-pane fade show active" id="faq-content" role="tabpanel" aria-labelledby="faq-content-tab">
                    {{ form_row(dataForm.sectionTitle) }}
                    {{ form_row(dataForm.sectionSubtitle) }}

                    <div class="faq-items-collection" id="faq-items-collection" data-index="{{ dataForm.items|length }}">
                        {% if dataForm.items is defined and dataForm.items|length > 0 %}
                            {% for itemForm in dataForm.items %}
                                <div class="collection-item mb-3 card" data-faq-item-index="{{ loop.index0 }}">
                                    <div class="card-header d-flex justify-content-between align-items-center">
                                        <strong>FAQ Item {{ loop.index }}</strong>
                                        <button type="button" class="btn btn-sm btn-outline-danger remove-faq-item" data-target="#faq-item-{{ loop.index0 }}">
                                            <i class="bi bi-trash"></i> Remove
                                        </button>
                                    </div>
                                    <div class="card-body">
                                        {{ form_row(itemForm.question) }}
                                        {{ form_row(itemForm.answer) }}
                                    </div>
                                </div>
                            {% endfor %}
                        {% else %}
                            <p class="text-muted small">No FAQ items yet. Click the button below to add your first question.</p>
                        {% endif %}
                    </div>

                    <button type="button" class="btn btn-sm btn-primary mt-2" id="add-faq-item-btn">
                        <i class="bi bi-plus-circle me-1"></i> Add FAQ Item
                    </button>

                    <div id="faq-item-prototype-source" style="display: none;">
                        {{ form_widget(dataForm.items.vars.prototype) }}
                    </div>
                </div>

                <div class="tab-pane fade" id="faq-style" role="tabpanel" aria-labelledby="faq-style-tab">
                    <h6 class="text-muted mb-3">Colors</h6>
                    {{ form_row(dataForm.backgroundColor) }}
                    {{ form_row(dataForm.textColor) }}
                    {{ form_row(dataForm.titleColor) }}
                    <hr class="my-4">
                    <h6 class="text-muted mb-3">FAQ Items</h6>
                    {{ form_row(dataForm.itemBackgroundColor) }}
                    {{ form_row(dataForm.itemBorderColor) }}
                    {{ form_row(dataForm.activeColor) }}
                </div>

                <div class="tab-pane fade" id="faq-layout" role="tabpanel" aria-labelledby="faq-layout-tab">
                    {{ form_row(dataForm.textAlignment) }}
                    <hr class="my-4">
                    <h6 class="text-muted mb-3">Spacing</h6>
                    <div class="row">
                        <div class="col-md-6">
                            {{ form_row(dataForm.paddingTop) }}
                        </div>
                        <div class="col-md-6">
                            {{ form_row(dataForm.paddingBottom) }}
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            {{ form_row(dataForm.marginTop) }}
                        </div>
                        <div class="col-md-6">
                            {{ form_row(dataForm.marginBottom) }}
                        </div>
                    </div>
                </div>
            </div>

            <script>
                (function() {
                    const container = document.getElementById('faq-items-collection');
                    const addBtn = document.getElementById('add-faq-item-btn');
                    const prototypeSource = document.getElementById('faq-item-prototype-source');
                    if (!container || !addBtn || !prototypeSource) {
                        return;
                    }

                    if (container.dataset.faqJsBound === '1') {
                        return;
                    }
                    container.dataset.faqJsBound = '1';

                    let nextIndex = container.dataset.index ? parseInt(container.dataset.index, 10) : 0;

                    function updateNames(containerItem, index) {
                        const inputs = containerItem.querySelectorAll('input, textarea, select');
                        inputs.forEach(function(input) {
                            const name = input.getAttribute('name') || '';
                            const updatedName = name.replace(/__name__/g, index.toString());
                            input.setAttribute('name', updatedName);

                            const id = input.getAttribute('id');
                            if (id) {
                                input.setAttribute('id', id.replace(/__name__/g, index.toString()));
                            }
                        });
                    }

                    function reindexLabels() {
                        container.querySelectorAll('.collection-item').forEach(function(item, i) {
                            const label = item.querySelector('strong');
                            if (label) {
                                label.textContent = 'FAQ Item ' + (i + 1);
                            }
                        });
                    }

                    addBtn.addEventListener('click', function() {
                        const source = prototypeSource.firstElementChild.cloneNode(true);
                        updateNames(source, nextIndex);

                        source.classList.add('collection-item', 'mb-3', 'card');
                        source.setAttribute('data-faq-item-index', nextIndex.toString());

                        source.querySelectorAll('input, textarea').forEach(function(input) {
                            if (input.type !== 'hidden') {
                                input.value = '';
                                if (input.hasAttribute('required')) {
                                    input.removeAttribute('required');
                                }
                            }
                        });

                        const header = document.createElement('div');
                        header.className = 'card-header d-flex justify-content-between align-items-center';
                        header.innerHTML = '<strong>FAQ Item X</strong>';

                        const removeBtn = document.createElement('button');
                        removeBtn.type = 'button';
                        removeBtn.className = 'btn btn-sm btn-outline-danger remove-faq-item';
                        removeBtn.innerHTML = '<i class="bi bi-trash"></i> Remove';
                        removeBtn.addEventListener('click', function() {
                            if (confirm('Remove this FAQ item?')) {
                                source.remove();
                                reindexLabels();
                            }
                        });
                        header.appendChild(removeBtn);

                        const body = document.createElement('div');
                        body.className = 'card-body';
                        while (source.firstChild) {
                            body.appendChild(source.firstChild);
                        }
                        source.appendChild(header);
                        source.appendChild(body);

                        container.appendChild(source);
                        nextIndex = nextIndex + 1;
                        container.dataset.index = nextIndex.toString();
                        reindexLabels();

                        const prototypeInputs = prototypeSource.querySelectorAll('input, textarea, select');
                        prototypeInputs.forEach(function(input) { input.value = ''; });
                    });

                    container.querySelectorAll('.collection-item').forEach(function(item) {
                        const removeBtn = item.querySelector('.remove-faq-item');
                        if (removeBtn && !removeBtn._faqJsBound) {
                            removeBtn._faqJsBound = true;
                            removeBtn.addEventListener('click', function() {
                                if (confirm('Remove this FAQ item?')) {
                                    item.remove();
                                    reindexLabels();
                                }
                            });
                        }
                    });
                })();
            </script>

