{% extends 'base.html.twig' %}

{% block title %}Save as Reference{% endblock %}

{% block body %}
<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <div class="d-flex justify-content-between align-items-center">
                        <h3 class="card-title mb-0">Save as Reference</h3>
                        <a href="{{ path('app_page_builder', {siteId: siteId, pageId: pageId}) }}" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i> Back to Builder
                        </a>
                    </div>
                </div>
                
                <div class="card-body">
                    <div class="alert alert-info mb-4">
                        <i class="bi bi-info-circle me-2"></i>
                        Save this section as a reference to reuse it across multiple pages.
                        <strong>Section type:</strong> {{ section.type|title }}
                    </div>

                    {{ form_start(form) }}
                    
                    <div class="mb-3">
                        {{ form_label(form.name, 'Reference Name', {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.name, {'attr': {'class': 'form-control', 'placeholder': 'e.g., Main Hero Section'}}) }}
                        {{ form_errors(form.name) }}
                    </div>
                    
                    <div class="d-flex justify-content-end gap-2">
                        <a href="{{ path('app_page_builder', {siteId: siteId, pageId: pageId}) }}" class="btn btn-outline-secondary">
                            Cancel
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-bookmark me-1"></i> Save as Reference
                        </button>
                    </div>
                    
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
