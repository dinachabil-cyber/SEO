{# Hero Blocks Builder Template #}
{# This template provides the UI for managing hero content blocks dynamically #}

<div class="hero-blocks-builder" data-builder="hero-blocks">
    <div class="builder-header d-flex justify-content-between align-items-center mb-3">
        <h6 class="mb-0">
            <i class="bi bi-layers me-2"></i>Content Blocks
        </h6>
        <div class="btn-group" role="group">
            <button type="button" class="btn btn-sm btn-primary dropdown-toggle" id="addBlockDropdown" data-bs-toggle="dropdown" aria-expanded="false" data-bs-auto-close="outside">
                <i class="bi bi-plus-circle me-1"></i> Add Block
            </button>
            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="addBlockDropdown">
                {% for type, label in block_types %}
                    <li>
                        <a class="dropdown-item js-add-block" href="#" data-type="{{ type }}">
                            {{ label }}
                        </a>
                    </li>
                {% endfor %}
            </ul>
        </div>
    </div>

    {# Hidden input to store the blocks JSON data #}
    <input type="hidden" name="page_section[blocks_json]" id="hero_blocks_json" value="{{ blocks_json|default('[]') }}">

    {# Blocks Container #}
    <div id="hero-blocks-container" class="blocks-container">
        {# Blocks will be rendered here dynamically #}
    </div>

    {# Empty State #}
    <div id="hero-blocks-empty" class="text-center py-4 {% if blocks and blocks|length > 0 %}d-none{% endif %}">
        <div class="text-muted">
            <i class="bi bi-grid-3x3-gap display-4"></i>
            <p class="mt-2">No content blocks yet</p>
            <p class="small">Click "Add Block" to start building your hero section</p>
        </div>
    </div>

    {# Block Configuration Templates #}
    <template id="hero-block-template-title">
        <div class="block-card card mb-3" data-block-type="title">
            <div class="card-header d-flex justify-content-between align-items-center bg-light">
                <span class="block-type-badge badge bg-primary">Title</span>
                <div class="block-actions">
                    <button type="button" class="btn btn-sm btn-outline-secondary me-1" onclick="toggleBlockConfig(this)" title="Configure">
                        <i class="bi bi-gear"></i>
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-danger" onclick="removeHeroBlock(this)" title="Remove">
                        <i class="bi bi-trash"></i>
                    </button>
                </div>
            </div>
            <div class="card-body block-config" style="display: none;">
                <div class="row">
                    <div class="col-md-8">
                        <div class="mb-3">
                            <label class="form-label">Title Text</label>
                            <input type="text" class="form-control block-field" name="blocks[__INDEX__][text]" value="">
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label class="form-label">HTML Tag</label>
                            <select class="form-select block-field" name="blocks[__INDEX__][tag]">
                                <option value="h1">H1</option>
                                <option value="h2" selected>H2</option>
                                <option value="h3">H3</option>
                                <option value="h4">H4</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label class="form-label">Alignment</label>
                            <select class="form-select block-field" name="blocks[__INDEX__][alignment]">
                                <option value="left">Left</option>
                                <option value="center" selected>Center</option>
                                <option value="right">Right</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label class="form-label">Color</label>
                            <input type="color" class="form-control block-field" name="blocks[__INDEX__][color]" value="#000000">
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label class="form-label">Size</label>
                            <select class="form-select block-field" name="blocks[__INDEX__][size]">
                                <option value="small">Small</option>
                                <option value="medium">Medium</option>
                                <option value="large" selected>Large</option>
                                <option value="xlarge">X-Large</option>
                                <option value="display">Display</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="mb-3 form-check">
                    <input type="checkbox" class="form-check-input block-field" name="blocks[__INDEX__][enabled]" id="title_enabled__INDEX__" checked>
                    <label class="form-check-label" for="title_enabled__INDEX__">Enable this block</label>
                </div>
                <input type="hidden" class="block-field" name="blocks[__INDEX__][type]" value="title">
            </div>
        </div>
    </template>

