{# Form Fields Builder Template #}
{# This template provides the UI for managing form fields dynamically #}

<div class="form-fields-builder" data-builder="form-fields">
    <div class="builder-header d-flex justify-content-between align-items-center mb-3">
        <h6 class="mb-0">
            <i class="bi bi-ui-checks-grid me-2"></i>Form Fields
        </h6>
        <div class="d-flex align-items-center gap-2">
            <select id="add-field-select" class="form-select form-select-sm" style="width: auto;">
                <option value="">Select field type...</option>
                {% for type, label in field_types %}
                    <option value="{{ type }}">{{ label }}</option>
                {% endfor %}
            </select>
            <button type="button" class="btn btn-sm btn-primary" onclick="handleAddField()">
                <i class="bi bi-plus-circle me-1"></i> Add Field
            </button>
        </div>
    </div>

    {# Hidden input to store the fields JSON data #}
    <input type="hidden" name="page_section[form_fields_json]" id="form_fields_json" value="{{ fields_json|default('[]') }}">

    {# Fields Container #}
    <div id="form-fields-container" class="fields-container">
        {# Fields will be rendered here dynamically #}
    </div>

    {# Empty State #}
    <div id="form-fields-empty" class="text-center py-4 {% if fields and fields|length > 0 %}d-none{% endif %}">
        <div class="text-muted">
            <i class="bi bi-input-cursor display-4"></i>
            <p class="mt-2">No form fields yet</p>
            <p class="small">Click "Add Field" to start building your form</p>
        </div>
    </div>

    {# Field Configuration Templates #}
    <template id="form-field-template-text">
        <div class="field-card card mb-3" data-field-type="text">
            <div class="card-header d-flex justify-content-between align-items-center bg-light">
                <span class="field-type-badge badge bg-primary">Text Input</span>
                <div class="field-actions">
                    <button type="button" class="btn btn-sm btn-outline-secondary me-1" onclick="toggleFieldConfig(this)">
                        <i class="bi bi-gear"></i>
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-danger" onclick="removeFormField(this)">
                        <i class="bi bi-trash"></i>
                    </button>
                </div>
            </div>
            <div class="card-body field-config" style="display: none;">
                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label">Field Label *</label>
                            <input type="text" class="form-control field-field" name="form_fields[__INDEX__][label]" value="" required>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label">Field Name *</label>
                            <input type="text" class="form-control field-field" name="form_fields[__INDEX__][name]" value="" placeholder="e.g., first_name" required>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label">Placeholder</label>
                            <input type="text" class="form-control field-field" name="form_fields[__INDEX__][placeholder]" value="">
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label">Default Value</label>
                            <input type="text" class="form-control field-field" name="form_fields[__INDEX__][default_value]" value="">
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label class="form-label">Width</label>
                            <select class="form-select field-field" name="form_fields[__INDEX__][width]">
                                <option value="full" selected>Full Width</option>
                                <option value="half">Half Width</option>
                                <option value="third">One Third</option>
                                <option value="two-thirds">Two Thirds</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label class="form-label">CSS Class</label>
                            <input type="text" class="form-control field-field" name="form_fields[__INDEX__][css_class]" value="">
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label class="form-label">&nbsp;</label>
                            <div class="form-check mt-2">
                                <input type="checkbox" class="form-check-input field-field" name="form_fields[__INDEX__][required]" id="text_required__INDEX__">
                                <label class="form-check-label" for="text_required__INDEX__">Required</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Help Text</label>
                    <input type="text" class="form-control field-field" name="form_fields[__INDEX__][help_text]" value="" placeholder="Text shown below the field">
                </div>
                <div class="mb-3 form-check">
                    <input type="checkbox" class="form-check-input field-field" name="form_fields[__INDEX__][enabled]" id="text_enabled__INDEX__" checked>
                    <label class="form-check-label" for="text_enabled__INDEX__">Enable this field</label>
                </div>
                <input type="hidden" class="field-field" name="form_fields[__INDEX__][type]" value="text">
            </div>
        </div>
    </template>

