<script>
let formFields = [];
let fieldCounter = 0;
let formFieldsBuilderInitialized = false;

function initFormFieldsBuilder() {
    const wrapper = document.querySelector('.form-fields-builder[data-builder="form-fields"]');
    if (!wrapper) {
        console.warn('form fields builder wrapper not found');
        return;
    }

    // avoid double init
    if (wrapper.dataset.initialized === '1') {
        console.log('Form fields builder already initialized');
        return;
    }
    wrapper.dataset.initialized = '1';

    console.log('initFormFieldsBuilder');

    const fallbackInput = document.getElementById('form_fields_json_fallback');
    const symfonyInput = document.getElementById('page_section_form_fields_json');
    const addBtn = document.getElementById('add-field-btn');

    console.log('fallbackInput:', fallbackInput ? 'found' : 'NOT FOUND');
    console.log('symfonyInput:', symfonyInput ? 'found' : 'NOT FOUND');
    console.log('addBtn:', addBtn ? 'found' : 'NOT FOUND');

    if (!fallbackInput) {
        console.error('fallback input not found');
        return;
    }

    console.log('fallbackInput value:', fallbackInput.value);

    try {
        const parsed = JSON.parse(fallbackInput.value || '[]');
        formFields = Array.isArray(parsed) ? parsed : [];
        console.log('Parsed formFields:', formFields);
    } catch (e) {
        console.error('JSON parse error', e);
        formFields = [];
    }

    fieldCounter = formFields.length;
    console.log('fieldCounter:', fieldCounter);

    if (symfonyInput) {
        symfonyInput.value = JSON.stringify(formFields);
        console.log('Set symfonyInput value:', symfonyInput.value);
    }

    renderFormFields();

    if (addBtn) {
        addBtn.addEventListener('click', handleAddField);
        console.log('add-field-btn connected');
    } else {
        console.error('add-field-btn not found');
    }
}

function handleAddField() {
    const select = document.getElementById('add-field-select');
    if (!select) {
        console.error('select not found');
        return;
    }

    const type = select.value;
    if (!type) {
        alert('Please select a field type');
        return;
    }

    addFormField(type);
    select.value = '';
}

function addFormField(type) {
    console.log('addFormField', type);

    const field = {
        type: type,
        enabled: true,
        id: 'field_' + (++fieldCounter)
    };
    
    console.log('Created field object:', field);

    switch (type) {
        case 'text':
            field.label = 'Text Field';
            field.name = 'text_field_' + fieldCounter;
            field.placeholder = '';
            field.required = false;
            field.width = 'full';
            break;
        case 'email':
            field.label = 'Email Address';
            field.name = 'email_' + fieldCounter;
            field.placeholder = 'your@email.com';
            field.required = true;
            field.width = 'full';
            break;
        case 'tel':
            field.label = 'Phone Number';
            field.name = 'phone_' + fieldCounter;
            field.placeholder = '+1 (555) 123-4567';
            field.required = false;
            field.width = 'full';
            break;
        case 'textarea':
            field.label = 'Message';
            field.name = 'message_' + fieldCounter;
            field.placeholder = 'Your message...';
            field.rows = '4';
            field.required = false;
            field.width = 'full';
            break;
        case 'select':
            field.label = 'Select Option';
            field.name = 'select_option_' + fieldCounter;
            field.options = "Option 1\nOption 2\nOption 3";
            field.required = false;
            field.width = 'full';
            break;
        case 'radio':
            field.label = 'Choose One';
            field.name = 'radio_option_' + fieldCounter;
            field.options = "Option 1\nOption 2\nOption 3";
            field.required = false;
            field.width = 'full';
            break;
        case 'checkbox':
            field.label = 'I agree';
            field.name = 'consent_' + fieldCounter;
            field.options = '';
            field.required = false;
            field.width = 'full';
            break;
        case 'number':
            field.label = 'Number';
            field.name = 'number_field_' + fieldCounter;
            field.required = false;
            field.width = 'full';
            break;
        case 'date':
            field.label = 'Date';
            field.name = 'date_field_' + fieldCounter;
            field.required = false;
            field.width = 'full';
            break;
        case 'hidden':
            field.label = '';
            field.name = 'hidden_field_' + fieldCounter;
            field.default_value = '';
            field.width = 'full';
            break;
    }

    formFields.push(field);
    renderFormFields();
    updateFieldsJson();
}

function removeFormField(btn) {
    const card = btn.closest('.field-card');
    if (!card) return;

    const index = parseInt(card.dataset.index, 10);
    if (isNaN(index)) return;

    formFields.splice(index, 1);
    renderFormFields();
    updateFieldsJson();
}

function toggleFieldConfig(btn) {
    const card = btn.closest('.field-card');
    if (!card) return;

    const config = card.querySelector('.field-config');
    if (!config) return;

    config.style.display = config.style.display === 'none' ? 'block' : 'none';
}

function renderFormFields() {
    console.log('renderFormFields called, formFields:', formFields);
    const container = document.getElementById('form-fields-container');
    const emptyState = document.getElementById('form-fields-empty');

    if (!container) {
        console.error('form-fields-container not found');
        return;
    }

    container.innerHTML = '';

    if (!Array.isArray(formFields) || formFields.length === 0) {
        console.log('No form fields to render, showing empty state');
        if (emptyState) emptyState.classList.remove('d-none');
        return;
    }

    console.log('Rendering', formFields.length, 'fields');
    if (emptyState) emptyState.classList.add('d-none');

    formFields.forEach(function(field, index) {
        const template = document.getElementById('form-field-template-' + field.type);
        if (!template) {
            console.warn('template not found for type:', field.type);
            return;
        }

        const html = template.innerHTML.replace(/__INDEX__/g, index);
        const tempDiv = document.createElement('div');
        tempDiv.innerHTML = html;

        const card = tempDiv.querySelector('.field-card');
        if (!card) return;

        card.dataset.index = index;

        const inputs = tempDiv.querySelectorAll('.field-field');
        inputs.forEach(function(input) {
            const match = input.name.match(/\[\d+\]\[(.+?)\]$/);
            if (!match) return;

            const key = match[1];
            if (!(key in field)) return;

            if (input.type === 'checkbox') {
                input.checked = !!field[key];
            } else {
                input.value = field[key] ?? '';
            }
        });

        container.appendChild(card);
    });
}

function updateFieldsJson() {
    const container = document.getElementById('form-fields-container');
    const symfonyInput = document.getElementById('page_section_form_fields_json');
    const fallbackInput = document.getElementById('form_fields_json_fallback');

    if (!container) return;

    const cards = container.querySelectorAll('.field-card');
    const updatedFields = [];

    cards.forEach(function(card) {
        const fieldData = {};
        const inputs = card.querySelectorAll('.field-field');

        inputs.forEach(function(input) {
            const match = input.name.match(/\[\d+\]\[(.+?)\]$/);
            if (!match) return;

            const key = match[1];

            if (input.type === 'checkbox') {
                fieldData[key] = input.checked;
            } else {
                fieldData[key] = input.value;
            }
        });

        if (!fieldData.type) {
            fieldData.type = card.dataset.fieldType || 'text';
        }

        updatedFields.push(fieldData);
    });

    formFields = updatedFields;
    const json = JSON.stringify(formFields);

    if (symfonyInput) {
        symfonyInput.value = json;
    }

    if (fallbackInput) {
        fallbackInput.value = json;
    }

    console.log('Saved JSON:', json);
}

document.addEventListener('change', function(e) {
    if (e.target.classList.contains('field-field')) {
        updateFieldsJson();
    }
});

document.addEventListener('input', function(e) {
    if (e.target.classList.contains('field-field')) {
        updateFieldsJson();
    }
});

document.addEventListener('submit', function() {
    updateFieldsJson();
});

// init for normal load
if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFormFieldsBuilder);
} else {
    initFormFieldsBuilder();
}

// init for turbo navigation if present
document.addEventListener('turbo:load', function() {
    const wrapper = document.querySelector('.form-fields-builder[data-builder="form-fields"]');
    if (wrapper) {
        wrapper.dataset.initialized = '0';
    }
    initFormFieldsBuilder();
});
</script>
