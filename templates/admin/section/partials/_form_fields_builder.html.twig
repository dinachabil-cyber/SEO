<script>
    // Form Fields Builder JavaScript
    let formFields = [];
    let fieldCounter = 0;

    // Initialize on page load
    document.addEventListener('DOMContentLoaded', function() {
        console.log('Form Fields Builder: DOMContentLoaded fired');
        const existingDataEl = document.getElementById('form_fields_json');
        if (!existingDataEl) {
            console.error('ERROR: form_fields_json hidden input not found!');
            return;
        }
        const existingData = existingDataEl.value;
        try {
            formFields = JSON.parse(existingData) || [];
            console.log('Form Fields loaded:', formFields);
        } catch(e) {
            console.error('Error parsing existing form fields:', e);
            formFields = [];
        }
        renderFormFields();
        
        // Use event delegation for add field buttons
        document.addEventListener('click', function(event) {
            const button = event.target.closest('.js-add-field-btn');
            if (button) {
                event.preventDefault();
                event.stopPropagation();
                const type = button.getAttribute('data-type');
                console.log('Add Field button clicked, type:', type);
                addFormField(type);
                // Close dropdown - find the toggle button
                const toggleBtn = button.closest('.btn-group').querySelector('.dropdown-toggle');
                if (toggleBtn) {
                    toggleBtn.classList.remove('show');
                    toggleBtn.setAttribute('aria-expanded', 'false');
                    const menu = toggleBtn.nextElementSibling;
                    if (menu && menu.classList.contains('dropdown-menu')) {
                        menu.classList.remove('show');
                    }
                }
            }
        });
    });

    function handleAddField() {
        const select = document.getElementById('add-field-select');
        const type = select.value;
        if (!type) {
            alert('Please select a field type');
            return;
        }
        addFormField(type);
        // Reset select
        select.value = '';
    }

    function addFormField(type) {
        console.log('Add Field function called, type:', type);
            type: type,
            enabled: true,
            id: 'field_' + (++fieldCounter)
        };

        // Add default values based on type
        switch(type) {
            case 'text':
                field.label = 'Text Field';
                field.name = 'text_field';
                field.placeholder = '';
                field.required = false;
                field.width = 'full';
                break;
            case 'email':
                field.label = 'Email Address';
                field.name = 'email';
                field.placeholder = 'your@email.com';
                field.required = true;
                field.width = 'full';
                break;
            case 'tel':
                field.label = 'Phone Number';
                field.name = 'phone';
                field.placeholder = '+1 (555) 123-4567';
                field.required = false;
                field.width = 'full';
                break;
            case 'textarea':
                field.label = 'Message';
                field.name = 'message';
                field.placeholder = 'Your message...';
                field.rows = '4';
                field.required = false;
                field.width = 'full';
                break;
            case 'select':
                field.label = 'Select Option';
                field.name = 'select_option';
                field.options = "Option 1\nOption 2\nOption 3";
                field.required = false;
                field.width = 'full';
                break;
            case 'radio':
                field.label = 'Choose One';
                field.name = 'radio_option';
                field.options = "Option 1\nOption 2\nOption 3";
                field.required = false;
                field.width = 'full';
                break;
            case 'checkbox':
                field.label = 'I agree';
                field.name = 'consent';
                field.options = '';
                field.required = false;
                field.width = 'full';
                break;
            case 'number':
                field.label = 'Number';
                field.name = 'number_field';
                field.required = false;
                field.width = 'full';
                break;
            case 'date':
                field.label = 'Date';
                field.name = 'date_field';
                field.required = false;
                field.width = 'full';
                break;
            case 'hidden':
                field.name = 'hidden_field';
                field.default_value = '';
                break;
        }

        formFields.push(field);
        renderFormFields();
        updateFieldsJson();
    }

    function removeFormField(btn) {
        const card = btn.closest('.field-card');
        const index = parseInt(card.dataset.index);
        formFields.splice(index, 1);
        renderFormFields();
        updateFieldsJson();
    }

    function toggleFieldConfig(btn) {
        const card = btn.closest('.field-card');
        const config = card.querySelector('.field-config');
        config.style.display = config.style.display === 'none' ? 'block' : 'none';
    }

    function renderFormFields() {
        const container = document.getElementById('form-fields-container');
        const emptyState = document.getElementById('form-fields-empty');

        container.innerHTML = '';

        if (formFields.length === 0) {
            emptyState.classList.remove('d-none');
            return;
        }

        emptyState.classList.add('d-none');

        formFields.forEach(function(field, index) {
            const templateId = 'form-field-template-' + field.type;
            const template = document.getElementById(templateId);

            if (template) {
                let html = template.innerHTML.replace(/__INDEX__/g, index);

                // Set values from field data
                const tempDiv = document.createElement('div');
                tempDiv.innerHTML = html;

                // Set field values
                Object.keys(field).forEach(function(key) {
                    if (key === 'type' || key === 'id') return;

                    const fieldEl = tempDiv.querySelector('[name$="[' + key + ']"]');
                    if (fieldEl) {
                        if (fieldEl.type === 'checkbox') {
                            fieldEl.checked = field[key];
                        } else {
                            fieldEl.value = field[key];
                        }
                    }
                });

                const card = tempDiv.querySelector('.field-card');
                card.dataset.index = index;
                container.appendChild(card);
            }
        });
    }

    function updateFieldsJson() {
        // Collect current values from the DOM
        const container = document.getElementById('form-fields-container');
        const cards = container.querySelectorAll('.field-card');

        cards.forEach(function(card, index) {
            const fields = card.querySelectorAll('.field-field');
            fields.forEach(function(field) {
                const name = field.name.match(/form_fields\[(\d+)\]\[(\w+)\]/);
                if (name) {
                    const fieldIndex = parseInt(name[1]);
                    const fieldName = name[2];

                    if (formFields[fieldIndex]) {
                        if (field.type === 'checkbox') {
                            formFields[fieldIndex][fieldName] = field.checked;
                        } else {
                            formFields[fieldIndex][fieldName] = field.value;
                        }
                    }
                }
            });
        });

        document.getElementById('form_fields_json').value = JSON.stringify(formFields);
    }

    // Save fields when form is submitted
    document.addEventListener('submit', function(e) {
        updateFieldsJson();
    });

    // Update fields on input change
    document.addEventListener('change', function(e) {
        if (e.target.classList.contains('field-field')) {
            updateFieldsJson();
        }
    });

    // Re-render on input change to keep index in sync
    document.addEventListener('input', function(e) {
        if (e.target.classList.contains('field-field')) {
            // Debounce the update
            clearTimeout(window.formFieldsUpdateTimeout);
            window.formFieldsUpdateTimeout = setTimeout(updateFieldsJson, 300);
        }
    });
</script>

