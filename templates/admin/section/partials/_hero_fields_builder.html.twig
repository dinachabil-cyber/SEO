
{# Hero Fields Builder Template #}
{# This template provides the UI for managing hero content fields dynamically #}
{# Replaces the block-based approach with a simple field builder #}

<div class="hero-fields-builder" data-builder="hero-fields">
    <div class="builder-header d-flex justify-content-between align-items-center mb-3">
        <h6 class="mb-0">
            <i class="bi bi-ui-checks me-2"></i>Form Fields
        </h6>
        <div class="d-flex align-items-center gap-2">
            <select id="add-field-type-select" class="form-select form-select-sm" style="width: auto;">
                <option value="">Select field type...</option>
                {% for type, label in field_types %}
                    <option value="{{ type }}">{{ label }}</option>
                {% endfor %}
            </select>
            <button type="button" class="btn btn-sm btn-primary" onclick="handleAddHeroField()">
                <i class="bi bi-plus-circle me-1"></i> Add Form Field
            </button>
        </div>
    </div>

    {# Hidden fallback input to load initial JSON (no name to avoid duplicate POST of the same field) #}
    <input type="hidden" id="hero_form_fields_fallback" data-hero-form-fields-json value="{{ hero_form_fields_json|default('[]') }}">
    {# Fields Container #}
    <div id="hero-fields-container" class="fields-container">
        {# Fields will be rendered here dynamically #}
    </div>

     {# Empty State #}
     <div id="hero-fields-empty" class="text-center py-4 {% if fields is defined and fields and fields|length > 0 %}d-none{% endif %}">
         <div class="text-muted">
             <i class="bi bi-ui-checks-grid display-4"></i>
             <p class="mt-2">No form fields yet</p>
             <p class="small">Click "Add Form Field" to start defining hero content fields</p>
         </div>
     </div>

    {# Field Configuration Templates for each type #}
    <template id="hero-field-template-text">
        <div class="field-card card mb-3" data-field-type="text">
            <div class="card-header d-flex justify-content-between align-items-center bg-light">
                <span class="field-type-badge badge bg-info">Text Input</span>
                <div class="field-actions">
                    <button type="button" class="btn btn-sm btn-outline-secondary me-1" onclick="toggleFieldConfig(this)" title="Configure">
                        <i class="bi bi-gear"></i>
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-danger" onclick="removeHeroField(this)" title="Remove">
                        <i class="bi bi-trash"></i>
                    </button>
                </div>
            </div>
            <div class="card-body field-config" style="display: none;">
                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label">Field Label *</label>
                            <input type="text" class="form-control field-field" data-field="label" value="" placeholder="e.g., Hero Title">
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label">Field Name (Key) *</label>
                            <input type="text" class="form-control field-field" data-field="name" value="" placeholder="e.g., hero_title">
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label">Default Value</label>
                            <input type="text" class="form-control field-field" name="fields[__INDEX__][default_value]" value="">
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label">Category/Tab</label>
                            <select class="form-select field-field" name="fields[__INDEX__][category]">
                                <option value="content" selected>Content</option>
                                <option value="media">Media</option>
                                <option value="style">Style</option>
                                <option value="buttons">Buttons</option>
                                <option value="layout">Layout</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Placeholder</label>
                    <input type="text" class="form-control field-field" name="fields[__INDEX__][placeholder]" value="" placeholder="Optional placeholder text">
                </div>
                <div class="mb-3">
                    <label class="form-label">Help Text</label>
                    <input type="text" class="form-control field-field" name="fields[__INDEX__][help_text]" value="" placeholder="Optional description">
                </div>
                <div class="form-check">
                    <input type="checkbox" class="form-check-input field-field" name="fields[__INDEX__][enabled]" id="field_enabled___INDEX__" value="1" checked>
                    <label class="form-check-label" for="field_enabled___INDEX__">Enable this field</label>
                </div>
                <input type="hidden" class="field-field" data-field="type" value="text">
            </div>
        </div>
    </template>

