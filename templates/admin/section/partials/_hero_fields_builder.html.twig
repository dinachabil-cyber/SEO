                    <input type="text" class="form-control field-field" name="fields[__INDEX__][help_text]" value="" placeholder="Optional description">
                </div>
                <div class="form-check">
                    <input type="checkbox" class="form-check-input field-field" name="fields[__INDEX__][enabled]" id="field_enabled___INDEX__" value="1" checked>
                    <label class="form-check-label" for="field_enabled___INDEX__">Enable this field</label>
                </div>
                <input type="hidden" class="field-field" data-field="type" value="number">
            </div>
        </div>
    </template>

    {# Generic fallback template for other types (email, tel, date) #}
    <template id="hero-field-template-generic">
        <div class="field-card card mb-3" data-field-type="__TYPE__">
            <div class="card-header d-flex justify-content-between align-items-center bg-light">
                <span class="field-type-badge badge bg-secondary">__TYPE_LABEL__</span>
                <div class="field-actions">
                    <button type="button" class="btn btn-sm btn-outline-secondary me-1" onclick="toggleFieldConfig(this)" title="Configure">
                        <i class="bi bi-gear"></i>
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-danger" onclick="removeHeroField(this)" title="Remove">
                        <i class="bi bi-trash"></i>
                    </button>
                </div>
            </div>
            <div class="card-body field-config" style="display: none;">
                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label">Field Label *</label>
                            <input type="text" class="form-control field-field" name="fields[__INDEX__][label]" value="" placeholder="Field label">
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label">Field Name (Key) *</label>
                            <input type="text" class="form-control field-field" name="fields[__INDEX__][name]" value="" placeholder="field_name">
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label">Default Value</label>
                            <input type="text" class="form-control field-field" name="fields[__INDEX__][default_value]" value="">
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label">Category/Tab</label>
                            <select class="form-select field-field" name="fields[__INDEX__][category]">
                                <option value="content" selected>Content</option>
                                <option value="media">Media</option>
                                <option value="style">Style</option>
                                <option value="buttons">Buttons</option>
                                <option value="layout">Layout</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Placeholder</label>
                    <input type="text" class="form-control field-field" name="fields[__INDEX__][placeholder]" value="" placeholder="Optional placeholder">
                </div>
                <div class="mb-3">
                    <label class="form-label">Help Text</label>
                    <input type="text" class="form-control field-field" name="fields[__INDEX__][help_text]" value="" placeholder="Optional description">
                </div>
                <div class="form-check">
                    <input type="checkbox" class="form-check-input field-field" name="fields[__INDEX__][enabled]" id="field_enabled___INDEX__" value="1" checked>
                    <label class="form-check-label" for="field_enabled___INDEX__">Enable this field</label>
                </div>
                <input type="hidden" class="field-field" name="fields[__INDEX__][type]" value="__TYPE__">
            </div>
        </div>
    </template>
</div>

<script>
let heroFieldIndex = 0;
let symfonyInputId = '{{ symfony_input_id|default('')|e('js') }}';

function findSymfonyHeroInput() {
    return (
        document.getElementById(symfonyInputId) ||
        document.querySelector('input[name="page_section[data][hero_form_fields]"]') ||
        document.querySelector('input[id^="page_section_data_"][name*="hero_form_fields"]') ||
        document.getElementById('page_section_data_hero_form_fields') ||
        null
    );
}

function handleAddHeroField() {
    const select = document.getElementById('add-field-type-select');
    const fieldType = select.value;

    if (!fieldType) {
        alert('Please select a field type');
        return;
    }

    addHeroField(fieldType);
    select.value = '';
}

function addHeroField(fieldType) {
    const container = document.getElementById('hero-fields-container');
    let template = document.getElementById('hero-field-template-' + fieldType);

    if (!template) {
        template = document.getElementById('hero-field-template-generic');
        if (!template) return;

        let html = template.innerHTML
            .replace(/__TYPE__/g, fieldType)
            .replace(/__TYPE_LABEL__/g, fieldType.charAt(0).toUpperCase() + fieldType.slice(1))
            .replace(/__INDEX__/g, heroFieldIndex);
        const tempDiv = document.createElement('div');
        tempDiv.innerHTML = html;
        const card = tempDiv.querySelector('.field-card');
        if (!card) return;
        card.dataset.index = heroFieldIndex;
        card.dataset.fieldType = fieldType;
        container.appendChild(card);
    } else {
        const html = template.innerHTML.replace(/__INDEX__/g, heroFieldIndex);
        const tempDiv = document.createElement('div');
        tempDiv.innerHTML = html;
        const card = tempDiv.querySelector('.field-card');
        if (!card) return;
        card.dataset.index = heroFieldIndex;
        container.appendChild(card);
    }

    heroFieldIndex++;
    updateHeroFieldsEmptyState();
    updateHeroFieldsJson();
}

function removeHeroField(button) {
    const card = button.closest('.field-card');
    if (!card) return;
    card.remove();
    updateHeroFieldsEmptyState();
    updateHeroFieldsJson();
}

function toggleFieldConfig(button) {
    const card = button.closest('.field-card');
    if (!card) return;
    const config = card.querySelector('.field-config');
    if (!config) return;
    config.style.display = config.style.display === 'none' ? 'block' : 'none';
}

function updateHeroFieldsEmptyState() {
    const container = document.getElementById('hero-fields-container');
    const emptyState = document.getElementById('hero-fields-empty');
    const fields = container.querySelectorAll('.field-card');

    if (fields.length > 0) {
        emptyState.classList.add('d-none');
    } else {
        emptyState.classList.remove('d-none');
    }
}

function updateHeroFieldsJson() {
    const container = document.getElementById('hero-fields-container');
    const symfonyInput = findSymfonyHeroInput();
    const fallbackInput = document.getElementById('hero_form_fields_fallback');
    if (!container) return;

    const cards = container.querySelectorAll('.field-card');
    const fieldsData = [];

    cards.forEach(function(card) {
        const fieldData = {};
        const inputs = card.querySelectorAll('.field-field');

        inputs.forEach(function(input) {
            const match = input.name.match(/\[\d+\]\[(.+?)\]$/);
            if (match) {
                const key = match[1];
                if (input.type === 'checkbox') {
                    fieldData[key] = input.checked;
                } else {
                    fieldData[key] = input.value;
                }
            } else if (input.dataset.field) {
                const key = input.dataset.field;
                if (input.type === 'checkbox') {
                    fieldData[key] = input.checked;
                } else if (input.tagName === 'SELECT') {
                    fieldData[key] = input.value;
                } else {
                    fieldData[key] = input.value;
                }
            }
        });

        if (!fieldData.type) {
            fieldData.type = card.dataset.fieldType || 'text';
        }

        fieldsData.push(fieldData);
    });

    const json = JSON.stringify(fieldsData);

    if (symfonyInput) {
        symfonyInput.value = json;
    }

    if (fallbackInput) {
        fallbackInput.value = json;
    }
}

function applyFieldValues(card, field) {
    const inputs = card.querySelectorAll('.field-field');
    inputs.forEach(function(input) {
        const match = input.name.match(/\[\d+\]\[(.+?)\]$/);
        if (match) {
            const key = match[1];
            if (!(key in field)) return;
            if (input.type === 'checkbox') {
                input.checked = !!field[key];
            } else if (input.tagName === 'SELECT') {
                const option = Array.from(input.options).find(function(opt) { return opt.value === field[key]; });
                if (option) option.selected = true;
            } else {
                input.value = field[key] ?? '';
            }
        } else if (input.dataset.field) {
            const key = input.dataset.field;
            if (!(key in field)) return;
            if (input.type === 'checkbox') {
                input.checked = !!field[key];
            } else if (input.tagName === 'SELECT') {
                const option = Array.from(input.options).find(function(opt) { return opt.value === field[key]; });
                if (option) option.selected = true;
            } else {
                input.value = field[key] ?? '';
            }
        }
    });
}

function loadHeroFields() {
    const jsonInput = findSymfonyHeroInput();
    let initialValue = jsonInput && jsonInput.value ? jsonInput.value : null;

    const fallbackInput = document.getElementById('hero_form_fields_fallback');
    if ((!initialValue || initialValue === '[]') && fallbackInput && fallbackInput.value) {
        initialValue = fallbackInput.value;
    }

    if (!initialValue) return;

    try {
        const parsed = JSON.parse(initialValue);
        const fields = Array.isArray(parsed) ? parsed : [];
        const container = document.getElementById('hero-fields-container');

        fields.forEach(function(field) {
            const fieldType = field.type || 'text';
            let template = document.getElementById('hero-field-template-' + fieldType);

            if (!template) {
                template = document.getElementById('hero-field-template-generic');
                if (!template) return;

                let html = template.innerHTML
                    .replace(/__TYPE__/g, fieldType)
                    .replace(/__TYPE_LABEL__/g, fieldType.charAt(0).toUpperCase() + fieldType.slice(1))
                    .replace(/__INDEX__/g, heroFieldIndex);
                const tempDiv = document.createElement('div');
                tempDiv.innerHTML = html;
                const card = tempDiv.querySelector('.field-card');
                if (!card) return;
                card.dataset.index = heroFieldIndex;
                card.dataset.fieldType = fieldType;

                applyFieldValues(card, field);
                container.appendChild(card);
            } else {
                const html = template.innerHTML.replace(/__INDEX__/g, heroFieldIndex);
                const tempDiv = document.createElement('div');
                tempDiv.innerHTML = html;
                const card = tempDiv.querySelector('.field-card');
                if (!card) return;
                card.dataset.index = heroFieldIndex;

                applyFieldValues(card, field);
                container.appendChild(card);
            }

            heroFieldIndex++;
        });

        updateHeroFieldsEmptyState();
    } catch (e) {
        console.error('Error parsing hero fields JSON:', e);
    }
}

if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', loadHeroFields);
} else {
    loadHeroFields();
}

document.addEventListener('input', function(e) {
    if (e.target.classList.contains('field-field')) {
        updateHeroFieldsJson();
    }
});

document.addEventListener('change', function(e) {
    if (e.target.classList.contains('field-field')) {
        updateHeroFieldsJson();
    }
});

document.addEventListener('submit', function() {
    updateHeroFieldsJson();
});
</script>
