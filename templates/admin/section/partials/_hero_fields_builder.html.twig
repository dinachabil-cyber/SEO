                    <input type="text" class="form-control field-field" name="fields[__INDEX__][help_text]" value="" placeholder="Optional description">
                </div>
                <div class="form-check">
                    <input type="checkbox" class="form-check-input field-field" name="fields[__INDEX__][enabled]" id="field_enabled___INDEX__" value="1" checked>
                    <label class="form-check-label" for="field_enabled___INDEX__">Enable this field</label>
                </div>
                <input type="hidden" class="field-field" data-field="type" value="number">
            </div>
        </div>
    </template>

    {# Generic fallback template for other types (email, tel, date) #}
    <template id="hero-field-template-generic">
        <div class="field-card card mb-3" data-field-type="__TYPE__">
            <div class="card-header d-flex justify-content-between align-items-center bg-light">
                <span class="field-type-badge badge bg-secondary">__TYPE_LABEL__</span>
                <div class="field-actions">
                    <button type="button" class="btn btn-sm btn-outline-secondary me-1" onclick="toggleFieldConfig(this)" title="Configure">
                        <i class="bi bi-gear"></i>
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-danger" onclick="removeHeroField(this)" title="Remove">
                        <i class="bi bi-trash"></i>
                    </button>
                </div>
            </div>
            <div class="card-body field-config" style="display: none;">
                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label">Field Label *</label>
                            <input type="text" class="form-control field-field" name="fields[__INDEX__][label]" value="" placeholder="Field label">
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label">Field Name (Key) *</label>
                            <input type="text" class="form-control field-field" name="fields[__INDEX__][name]" value="" placeholder="field_name">
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label">Default Value</label>
                            <input type="text" class="form-control field-field" name="fields[__INDEX__][default_value]" value="">
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label">Category/Tab</label>
                            <select class="form-select field-field" name="fields[__INDEX__][category]">
                                <option value="content" selected>Content</option>
                                <option value="media">Media</option>
                                <option value="style">Style</option>
                                <option value="buttons">Buttons</option>
                                <option value="layout">Layout</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Placeholder</label>
                    <input type="text" class="form-control field-field" name="fields[__INDEX__][placeholder]" value="" placeholder="Optional placeholder">
                </div>
                <div class="mb-3">
                    <label class="form-label">Help Text</label>
                    <input type="text" class="form-control field-field" name="fields[__INDEX__][help_text]" value="" placeholder="Optional description">
                </div>
                <div class="form-check">
                    <input type="checkbox" class="form-check-input field-field" name="fields[__INDEX__][enabled]" id="field_enabled___INDEX__" value="1" checked>
                    <label class="form-check-label" for="field_enabled___INDEX__">Enable this field</label>
                </div>
                <input type="hidden" class="field-field" name="fields[__INDEX__][type]" value="__TYPE__">
            </div>
        </div>
    </template>
</div>

<script>
// Hero Fields Builder JavaScript
let heroFieldIndex = 0;
let symfonyInputId = '{{ symfony_input_id|default('')|e('js') }}';
// Symfony hidden input id/name can vary depending on how this partial is included.
// Auto-detect the actual field that will be submitted in the parent PageSectionType form.
function findSymfonyHeroInput() {
    return (
        document.getElementById(symfonyInputId) ||
        document.querySelector('input[name="page_section[data][hero_form_fields]"]') ||
        document.getElementById('page_section_data_hero_form_fields') ||
        null
    );
}


function handleAddHeroField() {
    const select = document.getElementById('add-field-type-select');
    const fieldType = select.value;
    
    if (!fieldType) {
        alert('Please select a field type');
        return;
    }
    
    addHeroField(fieldType);
    select.value = '';
}

function addHeroField(fieldType) {
    const container = document.getElementById('hero-fields-container');
    const template = document.getElementById('hero-field-template-' + fieldType);
    
    if (!template) {
        // Use generic template for unknown types
        const genericTemplate = document.getElementById('hero-field-template-generic');
        const clone = genericTemplate.cloneNode(true);
        clone.innerHTML = clone.innerHTML.replace(/__TYPE__/g, fieldType).replace(/__TYPE_LABEL__/g, fieldType.charAt(0).toUpperCase() + fieldType.slice(1));
        clone.id = '';
        clone.style.display = 'block';
        
        // Update indices
        clone.innerHTML = clone.innerHTML.replace(/__INDEX__/g, heroFieldIndex);
        container.appendChild(clone);
    } else {
        const clone = template.cloneNode(true);
        clone.id = '';
        clone.style.display = 'block';
        
        // Update indices
        const html = clone.innerHTML.replace(/__INDEX__/g, heroFieldIndex);
        clone.innerHTML = html;
        container.appendChild(clone);
    }
    
    heroFieldIndex++;
    updateHeroFieldsEmptyState();
    updateHeroFieldsJson();
}

function removeHeroField(button) {
    const card = button.closest('.field-card');
    card.remove();
    updateHeroFieldsEmptyState();
    updateHeroFieldsJson();
}

function toggleFieldConfig(button) {
    const card = button.closest('.field-card');
    const config = card.querySelector('.field-config');
    if (config.style.display === 'none') {
        config.style.display = 'block';
    } else {
        config.style.display = 'none';
    }
}

function updateHeroFieldsEmptyState() {
    const container = document.getElementById('hero-fields-container');
    const emptyState = document.getElementById('hero-fields-empty');
    const fields = container.querySelectorAll('.field-card');
    
    if (fields.length > 0) {
        emptyState.classList.add('d-none');
    } else {
        emptyState.classList.remove('d-none');
    }
}

function updateHeroFieldsJson() {
    const container = document.getElementById('hero-fields-container');
    if (!container) return;

    const fields = container.querySelectorAll('.field-card');
    const fieldsData = [];

    fields.forEach(function(fieldCard) {
        const getVal = (selector, fallback = '') => {
            const el = fieldCard.querySelector(selector);
            if (!el) return fallback;
        const tag = (el.tagName || '').toUpperCase();
            if (tag === 'TEXTAREA' || tag === 'INPUT' || tag === 'SELECT') return el.value ?? fallback;
            return fallback;
        };

        const getChecked = (selector, fallback = false) => {
            const el = fieldCard.querySelector(selector);
            return el ? !!el.checked : fallback;
        };

        const fieldData = {
            type: getVal('input[type="hidden"][data-field="type"], input[name*="[type]"], input[name*="[type]"]') || (fieldCard.dataset.fieldType || 'text'),
            label: getVal('.field-field[data-field="label"], input[name*="[label]"], input[name*="[label"]'),
            name: getVal('.field-field[data-field="name"], input[name*="[name]"], input[name*="[name"]'),
            default_value: getVal('.field-field[data-field="default_value"], textarea[name*="[default_value]"], input[name*="[default_value]"], textarea[name*="[default_value]"], input[name*="[default_value"]'),
            category: getVal('select[name*="[category]"], select.field-field[name*="[category]"], .field-field[data-field="category"]', 'content'),
            placeholder: getVal('.field-field[data-field="placeholder"], input[name*="[placeholder]"], input[name*="[placeholder"]'),
            help_text: getVal('.field-field[data-field="help_text"], input[name*="[help_text]"], input[name*="[help_text"]'),
            options: getVal('textarea[name*="[options]"], textarea.field-field[data-field="options"], textarea[data-field="options"]'),
            enabled: getChecked('input[name*="[enabled]"], input.field-field[name*="[enabled]"], input.field-field[data-field="enabled"]')
        };

        // Normalize enabled/default_value for different input types
        if (typeof fieldData.enabled !== 'boolean') fieldData.enabled = !!fieldData.enabled;
        if (fieldData.type === 'checkbox' && (fieldData.default_value === '1' || fieldData.default_value === 1)) {
            // keep as-is
        }

        fieldsData.push(fieldData);
    });

    const symfonyInput = findSymfonyHeroInput();
    if (symfonyInput) symfonyInput.value = JSON.stringify(fieldsData);

    const fallbackInput = document.getElementById('hero_form_fields_fallback');
    if (fallbackInput) fallbackInput.value = JSON.stringify(fieldsData);
}

// Initialize - load existing fields
document.addEventListener('DOMContentLoaded', function() {
    const jsonInput = findSymfonyHeroInput();
    console.log('Symfony hero_form_fields input element:', jsonInput);
    console.log('hero_form_fields input value:', jsonInput ? jsonInput.value : 'not found');
    
    let initialValue = jsonInput && jsonInput.value ? jsonInput.value : null;

    
    const fallbackInput = document.getElementById('hero_form_fields_fallback');
    console.log('Fallback hero_form_fields input element:', fallbackInput);
    console.log('Fallback value:', fallbackInput ? fallbackInput.value : 'not found');
    
    if ((!initialValue || initialValue === '[]') && fallbackInput && fallbackInput.value) {
        initialValue = fallbackInput.value;
    }
    
    if (initialValue) {
        try {
            const parsed = JSON.parse(initialValue);
            console.log('Parsed hero fields:', parsed);
            const fields = Array.isArray(parsed) ? parsed : [];
            console.log('Loading hero fields, count:', fields.length);
            const container = document.getElementById('hero-fields-container');
            
            fields.forEach(function(field) {
                const fieldType = field.type || 'text';
                const template = document.getElementById('hero-field-template-' + fieldType);
                
                if (template) {
                    const clone = template.cloneNode(true);
                    clone.id = '';
                    clone.style.display = 'block';
                    
                    let html = clone.innerHTML.replace(/__INDEX__/g, heroFieldIndex);
                    html = html.replace(/name="fields\[__INDEX__\]\[label\]" value="/, 'name="fields[' + heroFieldIndex + '][label]" value="' + (field.label || ''));
                    html = html.replace(/name="fields\[__INDEX__\]\[name\]" value="/, 'name="fields[' + heroFieldIndex + '][name]" value="' + (field.name || ''));
                    html = html.replace(/name="fields\[__INDEX__\]\[default_value\]"(?: value="[^"]*")?>/, 'name="fields[' + heroFieldIndex + '][default_value]" value="' + (field.default_value || '') + '">');
                    html = html.replace(/name="fields\[__INDEX__\]\[placeholder\]" value="/, 'name="fields[' + heroFieldIndex + '][placeholder]" value="' + (field.placeholder || ''));
                    html = html.replace(/name="fields\[__INDEX__\]\[help_text\]" value="/, 'name="fields[' + heroFieldIndex + '][help_text]" value="' + (field.help_text || ''));
                    
                    if (field.category) {
                        html = html.replace(/value="content">/, 'value="' + field.category + '">');
                    }
                    
                    if (field.enabled === false) {
                        html = html.replace(/name="fields\[__INDEX__\]\[enabled\]" value="1" checked/, 'name="fields[' + heroFieldIndex + '][enabled]" value="1"');
                    }
                    
                    clone.innerHTML = html;
                    container.appendChild(clone);
                    heroFieldIndex++;
                }
            });
            
            updateHeroFieldsEmptyState();
        } catch (e) {
            console.error('Error parsing hero fields JSON:', e);
        }
    }
    

    document.addEventListener('input', function(e) {

        if (e.target.classList.contains('field-field')) {
            updateHeroFieldsJson();
        }
    });
    
    document.addEventListener('change', function(e) {
        if (e.target.classList.contains('field-field')) {
            updateHeroFieldsJson();
        }
    });
});
</script>
