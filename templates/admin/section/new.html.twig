{% extends 'base.html.twig' %}

{% block title %}Add Section{% endblock %}

{% block body %}
<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <div class="d-flex justify-content-between align-items-center">
                        <h3 class="card-title mb-0">Add Section</h3>
                        {% include 'admin/partials/_back_button.html.twig' %}
                    </div>
                </div>
                
                <div class="card-body">
                    {{ form_start(form, {attr: {class: 'needs-validation', 'data-turbo': 'false', 'novalidate': 'novalidate'}}) }}
                    
                    {% include 'admin/section/_form.html.twig' %}
                    
                    <script>
                    (function() {
                        const typeField = document.querySelector('[name="{{ form.type.vars.full_name }}"]');
                        if (typeField) {
                            typeField.addEventListener('change', () => {
                                if (typeField.value) {
                                    if (typeof updateHeroFieldsJson === 'function') {
                                        updateHeroFieldsJson();
                                    }
                                    if (typeof updateFieldsJson === 'function') {
                                        updateFieldsJson();
                                    }
                                    // Signal the controller to re-render the form with the
                                    // type-specific fields instead of persisting a new section.
                                    const marker = document.createElement('input');
                                    marker.type = 'hidden';
                                    marker.name = '_rerender';
                                    marker.id = 'type-change-marker';
                                    marker.value = '1';
                                    typeField.form.appendChild(marker);
                                    if (typeof typeField.form.requestSubmit === 'function') {
                                        typeField.form.requestSubmit();
                                    } else {
                                        typeField.form.submit();
                                    }
                                }
                            });
                        }
                    })();
                    </script>
                    
                    <div class="d-flex justify-content-end gap-2">
                        <a href="{{ path('app_page_builder', {siteId: site.id, pageId: page.id}) }}" class="btn btn-outline-secondary">
                            Cancel
                        </a>
                        <a href="{{ path('app_preview_page', {'id': page.id}) }}" class="btn btn-outline-info">
                            <i class="bi bi-eye me-1"></i> Preview
                        </a>
                        <button type="submit" class="btn btn-primary" onclick="(function(){var m=document.getElementById('type-change-marker');if(m){m.remove();}})();">
                            <i class="bi bi-plus-circle me-1"></i> Add Section
                        </button>
                    </div>
                    
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
