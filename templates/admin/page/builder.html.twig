{% extends 'base.html.twig' %}

{% block title %}Page Builder - {{ page.metaTitle }}{% endblock %}

{% block body %}
<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <div class="d-flex justify-content-between align-items-center">
                        <h3 class="card-title mb-0">Page Builder - {{ page.metaTitle }}</h3>
                        <div class="d-flex gap-2">
                            {% include 'admin/partials/_back_button.html.twig' with {'back_url': path('app_site_show', {'id': page.site.id})} %}
                            <a href="{{ path('app_page_edit', {site: page.site.id, pageId: page.id}) }}" class="btn btn-outline-secondary">
                                <i class="bi bi-pencil-square me-1"></i> Page Settings
                            </a>
                            <a href="{{ path('app_front_page', {slug: page.slug}) }}" class="btn btn-outline-info">
                                <i class="bi bi-eye me-1"></i> Preview
                            </a>
                            <a href="{{ path('app_site_show', {id: page.site.id}) }}" class="btn btn-outline-dark">
                                <i class="bi bi-building me-1"></i> Site
                            </a>
                        </div>
                    </div>
                </div>
                
                <div class="card-body">
                    {# Page Details Section #}
                    <div class="mb-4 p-3 bg-light rounded">
                        <div class="row">
                            <div class="col-md-6">
                                <h6 class="fw-bold">Page Details:</h6>
                                <p class="mb-1"><strong>Slug:</strong> {{ page.slug }}</p>
                                <p class="mb-1"><strong>Title:</strong> {{ page.metaTitle }}</p>
                                <p class="mb-1"><strong>Status:</strong> 
                                    <span class="badge {% if page.isPublished %}bg-success{% else %}bg-warning{% endif %}">
                                        {% if page.isPublished %}Published{% else %}Draft{% endif %}
                                    </span>
                                </p>
                            </div>
                            <div class="col-md-6">
                                <h6 class="fw-bold">SEO Information:</h6>
                                {% if page.googleAdsId %}
                                    <p class="mb-1"><strong>Google Ads ID:</strong> {{ page.googleAdsId }}</p>
                                {% endif %}
                                {% if page.googleAnalyticsId %}
                                    <p class="mb-1"><strong>Google Analytics ID:</strong> {{ page.googleAnalyticsId }}</p>
                                {% endif %}
                                {% if page.googleTagManagerId %}
                                    <p class="mb-1"><strong>Google Tag Manager ID:</strong> {{ page.googleTagManagerId }}</p>
                                {% endif %}
                                <p class="mb-1"><strong>Meta Title:</strong> {{ page.metaTitle }}</p>
                                <p class="mb-1"><strong>Meta Description:</strong> {{ page.metaDescription }}</p>
                                {% if page.metaKeywords %}
                                    <p class="mb-1"><strong>Meta Keywords:</strong> {{ page.metaKeywords }}</p>
                                {% endif %}
                            </div>
                        </div>
                    </div>

                    {# Page H1 #}
                    <div class="mb-4 p-3 bg-white border rounded">
                        <h6 class="fw-bold">H1:</h6>
                        <p class="mb-0">{{ page.h1 }}</p>
                    </div>

                    {# Action Buttons #}
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h4 class="mb-0">Sections</h4>
                        <div class="d-flex gap-2">
                            <a href="{{ path('app_section_new', {siteId: page.site.id, pageId: page.id}) }}" class="btn btn-primary">
                                <i class="bi bi-plus-circle me-1"></i> Add Section
                            </a>
                            <a href="{{ path('app_reference_list', {siteId: page.site.id, pageId: page.id}) }}" class="btn btn-outline-primary">
                                <i class="bi bi-box-arrow-in-down me-1"></i> Import Reference
                            </a>
                        </div>
                    </div>

                    {# Sections List #}
                    <div class="sections-list">
                        {% if page.sections is empty %}
                            <div class="text-center py-10">
                                <i class="bi bi-file-earmark-text display-1 text-muted mb-3"></i>
                                <h4 class="mb-2">No Sections Yet</h4>
                                <p class="text-muted mb-4">Start building your page by adding sections</p>
                                <a href="{{ path('app_section_new', {siteId: page.site.id, pageId: page.id}) }}" class="btn btn-primary">
                                    <i class="bi bi-plus-circle me-1"></i> Add First Section
                                </a>
                            </div>
                        {% else %}
                    {% for section in page.sections %}
                        <div class="card mb-4 section-card border-0 shadow-sm">
                            <div class="card-header d-flex justify-content-between align-items-center bg-white border-bottom-2 border-primary">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge bg-primary">{{ section.type|title }}</span>
                                    {% if section.data.sectionTitle is defined and section.data.sectionTitle %}
                                        <span class="fw-semibold">{{ section.data.sectionTitle }}</span>
                                    {% elseif section.data.title is defined and section.data.title %}
                                        <span class="fw-semibold">{{ section.data.title }}</span>
                                    {% endif %}
                                </div>
                                        <div class="d-flex gap-1">
                                            <a href="{{ path('app_section_edit', {siteId: page.site.id, pageId: page.id, sectionId: section.id}) }}" class="btn btn-sm btn-outline-primary">
                                                <i class="bi bi-pencil"></i> Edit
                                            </a>
                                            <a href="{{ path('app_reference_save', {siteId: page.site.id, pageId: page.id, sectionId: section.id}) }}" class="btn btn-sm btn-outline-info">
                                                <i class="bi bi-bookmark"></i> Save as Reference
                                            </a>
                                            <form method="POST" action="{{ path('app_section_delete', {siteId: page.site.id, pageId: page.id, sectionId: section.id}) }}" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this section?');">
                                                <input type="hidden" name="_token" value="{{ csrf_token('delete_section' ~ section.id) }}">
                                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                                    <i class="bi bi-trash"></i> Delete
                                                </button>
                                            </form>
                                            {% if loop.index0 > 0 %}
                                                <form method="POST" action="{{ path('app_section_up', {siteId: page.site.id, pageId: page.id, sectionId: section.id}) }}" class="d-inline">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('move_section' ~ section.id) }}">
                                                    <button type="submit" class="btn btn-sm btn-outline-secondary">
                                                        <i class="bi bi-arrow-up"></i> Up
                                                    </button>
                                                </form>
                                            {% else %}
                                                <button type="button" class="btn btn-sm btn-outline-secondary" disabled>
                                                    <i class="bi bi-arrow-up"></i> Up
                                                </button>
                                            {% endif %}
                                            {% if loop.index < page.sections|length %}
                                                <form method="POST" action="{{ path('app_section_down', {siteId: page.site.id, pageId: page.id, sectionId: section.id}) }}" class="d-inline">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('move_section' ~ section.id) }}">
                                                    <button type="submit" class="btn btn-sm btn-outline-secondary">
                                                        <i class="bi bi-arrow-down"></i> Down
                                                    </button>
                                                </form>
                                            {% else %}
                                                <button type="button" class="btn btn-sm btn-outline-secondary" disabled>
                                                    <i class="bi bi-arrow-down"></i> Down
                                                </button>
                                            {% endif %}
                                        </div>
                                    </div>
                                    <div class="card-body">
                                        {% set data = section.effectiveData %}
                                        {% if section.type == 'header' %}
                                            <p><strong>Logo Text:</strong> {{ data.logoText ?? '' }}</p>
                                            {% if data.ctaText|default('') != '' and data.ctaUrl|default('') != '' %}
                                                <p><strong>CTA:</strong> {{ data.ctaText ?? '' }} ({{ data.ctaUrl ?? '' }})</p>
                                            {% endif %}
                                        {% elseif section.type == 'hero' %}
                                            {% if data.hero_title %}
                                                <p><strong>Title:</strong> {{ data.hero_title }}</p>
                                            {% endif %}
                                            {% if data.hero_subtitle %}
                                                <p><strong>Subtitle:</strong> {{ data.hero_subtitle }}</p>
                                            {% endif %}
                                            {% if data.badge_text %}
                                                <p><strong>Badge:</strong> {{ data.badge_text }}</p>
                                            {% endif %}
                                            {% if data.description %}
                                                <p><strong>Description:</strong> {{ data.description }}</p>
                                            {% endif %}
                                            {% if data.primary_button_text %}
                                                <p><strong>Primary Button:</strong> {{ data.primary_button_text }} ({{ data.primary_button_url ?? '#' }})</p>
                                            {% endif %}
                                            {% if data.secondary_button_text %}
                                                <p><strong>Secondary Button:</strong> {{ data.secondary_button_text }} ({{ data.secondary_button_url ?? '#' }})</p>
                                            {% endif %}
                                            {% if data.blocks is defined and data.blocks|length > 0 %}
                                                <p><strong>Blocks:</strong> {{ data.blocks|length }} block(s) configured</p>
                                            {% endif %}
                                        {% elseif section.type == 'body' %}
                                            <p><strong>Content:</strong> {{ (data.content ?? data.html ?? '')|striptags|slice(0, 100) }}...</p>
                                        {% elseif section.type == 'image' %}
                                            <p><strong>Image:</strong> {{ data.imageUrl ?? '' }}</p>
                                            <p><strong>Alt:</strong> {{ data.alt ?? '' }}</p>
                                        {% elseif section.type == 'cards' or section.type == 'cards_premium' %}
                                            {% if data.sectionTitle is defined and data.sectionTitle %}
                                                <p><strong>Title:</strong> {{ data.sectionTitle ?? '' }}</p>
                                            {% endif %}
                                            <p><strong>Cards:</strong> {{ (data.cards ?? [])|length }} card(s)</p>
                                        {% elseif section.type == 'faq' %}
                                            {% if data.sectionTitle %}
                                                <p><strong>Title:</strong> {{ data.sectionTitle ?? '' }}</p>
                                            {% endif %}
                                            <p><strong>Items:</strong> {{ (data.items ?? [])|length }} FAQ item(s)</p>
                                        {% elseif section.type == 'form' %}
                                            {% if data.form_title %}
                                                <p><strong>Form Title:</strong> {{ data.form_title }}</p>
                                            {% endif %}
                                            {% if data.section_title %}
                                                <p><strong>Section Title:</strong> {{ data.section_title }}</p>
                                            {% endif %}
                                            <p><strong>Fields:</strong> {{ (data.form_fields ?? [])|length }} field(s) configured</p>
                                            {% if data.form_layout %}
                                                <p><strong>Layout:</strong> {{ data.form_layout }}</p>
                                            {% endif %}
                                        {% elseif section.type == 'cta' %}
                                            <p><strong>Title:</strong> {{ data.title ?? '' }}</p>
                                            <p><strong>Button:</strong> {{ data.buttonText ?? '' }} ({{ data.buttonUrl ?? '' }})</p>
                                        {% elseif section.type == 'footer' %}
                                            <p><strong>Text:</strong> {{ (data.text ?? '')|striptags|slice(0, 100) }}...</p>
                                            {% if data.phone %}
                                                <p><strong>Phone:</strong> {{ data.phone ?? '' }}</p>
                                            {% endif %}
                                            {% if data.email %}
                                                <p><strong>Email:</strong> {{ data.email ?? '' }}</p>
                                            {% endif %}
                                            {% if data.ctaText|default('') != '' %}
                                                <p><strong>CTA:</strong> {{ data.ctaText ?? '' }} ({{ data.ctaUrl ?? '' }})</p>
                                            {% endif %}
                                        {% endif %}
                                    </div>
                                </div>
                            {% endfor %}
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
