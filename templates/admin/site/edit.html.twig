{% extends 'base.html.twig' %}

{% block title %}Edit Site{% endblock %}

{% block body %}
<div class="container">
    <h1 class="mb-4">Edit Site</h1>

    {% for flashType, flashMessages in app.flashes %}
        {% for flashMessage in flashMessages %}
            <div class="alert alert-{{ flashType }} alert-dismissible fade show" role="alert">
                {{ flashMessage }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}
    {% endfor %}

    <div class="row">
        <div class="col-12">
            {{ form_start(form, { 'attr': { 'class': 'site-form' } }) }}
            
            <!-- Site Information Section -->
            <div class="card mb-4">
                <div class="card-header bg-primary bg-opacity-10 border-primary">
                    <h5 class="card-title mb-0 text-primary">
                        <i class="bi bi-info-circle me-2"></i> Site Information
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row g-4">
                        <div class="col-md-6">
                            <div class="form-group">
                                {{ form_label(form.name, null, { 'attr': { 'class': 'form-label fw-bold' } }) }}
                                {{ form_widget(form.name) }}
                                {{ form_errors(form.name) }}
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                {{ form_label(form.domain, null, { 'attr': { 'class': 'form-label fw-bold' } }) }}
                                {{ form_widget(form.domain) }}
                                {{ form_errors(form.domain) }}
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                {{ form_label(form.defaultLocale, null, { 'attr': { 'class': 'form-label fw-bold' } }) }}
                                {{ form_widget(form.defaultLocale) }}
                                {{ form_errors(form.defaultLocale) }}
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                {{ form_label(form.status, null, { 'attr': { 'class': 'form-label fw-bold' } }) }}
                                {{ form_widget(form.status) }}
                                {{ form_errors(form.status) }}
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                {{ form_label(form.publishedAt, null, { 'attr': { 'class': 'form-label fw-bold' } }) }}
                                {{ form_widget(form.publishedAt) }}
                                {{ form_errors(form.publishedAt) }}
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-check form-switch mt-4">
                                {{ form_widget(form.isActive, { 'attr': { 'class': 'form-check-input' } }) }}
                                {{ form_label(form.isActive, null, { 'attr': { 'class': 'form-check-label' } }) }}
                                {{ form_errors(form.isActive) }}
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Technical Information Section -->
            <div class="card mb-4">
                <div class="card-header bg-info bg-opacity-10 border-info">
                    <h5 class="card-title mb-0 text-info">
                        <i class="bi bi-gear me-2"></i> Technical Information
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row g-4">
                        <div class="col-md-6">
                            <div class="form-group">
                                {{ form_label(form.hosting, null, { 'attr': { 'class': 'form-label fw-bold' } }) }}
                                {{ form_widget(form.hosting) }}
                                {{ form_errors(form.hosting) }}
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                {{ form_label(form.technology, null, { 'attr': { 'class': 'form-label fw-bold' } }) }}
                                {{ form_widget(form.technology) }}
                                {{ form_errors(form.technology) }}
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                {{ form_label(form.databaseName, null, { 'attr': { 'class': 'form-label fw-bold' } }) }}
                                {{ form_widget(form.databaseName) }}
                                {{ form_errors(form.databaseName) }}
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                {{ form_label(form.databasePassword, null, { 'attr': { 'class': 'form-label fw-bold' } }) }}
                                <div class="input-group">
                                    {{ form_widget(form.databasePassword) }}
                                    <button class="btn btn-outline-secondary" type="button" id="togglePassword">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                </div>
                                {{ form_errors(form.databasePassword) }}
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Imprint Information Section -->
            <div class="card mb-4">
                <div class="card-header bg-success bg-opacity-10 border-success">
                    <h5 class="card-title mb-0 text-success">
                        <i class="bi bi-building me-2"></i> Imprint Information
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row g-4">
                        <div class="col-md-6">
                            <div class="form-group">
                                {{ form_label(form.companyName, null, { 'attr': { 'class': 'form-label fw-bold' } }) }}
                                {{ form_widget(form.companyName) }}
                                {{ form_errors(form.companyName) }}
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                {{ form_label(form.phone, null, { 'attr': { 'class': 'form-label fw-bold' } }) }}
                                {{ form_widget(form.phone) }}
                                {{ form_errors(form.phone) }}
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                {{ form_label(form.email, null, { 'attr': { 'class': 'form-label fw-bold' } }) }}
                                {{ form_widget(form.email) }}
                                {{ form_errors(form.email) }}
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                {{ form_label(form.registrationNumber, null, { 'attr': { 'class': 'form-label fw-bold' } }) }}
                                {{ form_widget(form.registrationNumber) }}
                                {{ form_errors(form.registrationNumber) }}
                            </div>
                        </div>
                        <div class="col-md-12">
                            <div class="form-group">
                                {{ form_label(form.address, null, { 'attr': { 'class': 'form-label fw-bold' } }) }}
                                {{ form_widget(form.address) }}
                                {{ form_errors(form.address) }}
                            </div>
                        </div>
                        <div class="col-md-12">
                            <div class="form-group">
                                {{ form_label(form.legalRepresentative, null, { 'attr': { 'class': 'form-label fw-bold' } }) }}
                                {{ form_widget(form.legalRepresentative) }}
                                {{ form_errors(form.legalRepresentative) }}
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Form Actions -->
            <div class="card">
                <div class="card-body d-flex justify-content-end gap-3">
                    <a href="{{ path('app_site_index') }}" class="btn btn-outline-secondary btn-lg">
                        <i class="bi bi-arrow-left me-2"></i> Back to List
                    </a>
                    <a href="{{ path('app_site_show', {'id': site.id}) }}" class="btn btn-outline-info btn-lg">
                        <i class="bi bi-eye me-2"></i> View Site
                    </a>
                    <button type="submit" class="btn btn-primary btn-lg">
                        <i class="bi bi-save me-2"></i> Update Site
                    </button>
                </div>
            </div>
            
            {{ form_end(form) }}
        </div>
    </div>

    <script>
        // Password toggle functionality
        document.getElementById('togglePassword').addEventListener('click', function() {
            const passwordInput = document.querySelector('input[name="site[databasePassword]"]');
            const icon = this.querySelector('i');
            
            if (passwordInput.type === 'password') {
                passwordInput.type = 'text';
                icon.classList.remove('bi-eye');
                icon.classList.add('bi-eye-slash');
            } else {
                passwordInput.type = 'password';
                icon.classList.remove('bi-eye-slash');
                icon.classList.add('bi-eye');
            }
        });
    </script>
</div>
{% endblock %}
