{% extends 'base.html.twig' %}

{% block title %}Reference Sections{% endblock %}

{% block body %}
<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <div class="d-flex justify-content-between align-items-center">
                        <h3 class="card-title mb-0">Reference Sections</h3>
                        <a href="{{ path('app_site_index') }}" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i> Back to Sites
                        </a>
                    </div>
                </div>
                
                <div class="card-body">
                    {% if references is empty %}
                        <div class="text-center py-5">
                            <i class="bi bi-bookmark display-1 text-muted mb-3"></i>
                            <h4 class="mb-2">No References Yet</h4>
                            <p class="text-muted mb-4">Save sections as references from the page builder to reuse them across pages.</p>
                            <a href="{{ path('app_site_index') }}" class="btn btn-primary">
                                <i class="bi bi-building me-1"></i> Go to Sites
                            </a>
                        </div>
                    {% else %}
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>ID</th>
                                        <th>Name</th>
                                        <th>Type</th>
                                        <th>Created</th>
                                        <th>Updated</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for reference in references %}
                                        <tr>
                                            <td>{{ reference.id }}</td>
                                            <td>
                                                <i class="bi bi-bookmark me-1"></i>
                                                {{ reference.name }}
                                            </td>
                                            <td>
                                                <span class="badge bg-primary">{{ reference.type|title }}</span>
                                            </td>
                                            <td>{{ reference.createdAt|date('Y-m-d H:i') }}</td>
                                            <td>{{ reference.updatedAt|date('Y-m-d H:i') }}</td>
                                            <td>
                                                <form method="POST" action="{{ path('app_reference_delete', {id: reference.id}) }}" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this reference?');">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ reference.id) }}">
                                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                                        <i class="bi bi-trash"></i> Delete
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
