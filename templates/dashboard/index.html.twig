{% extends 'base.html.twig' %}

{% block title %}Dashboard{% endblock %}

{% block body %}
<div class="container mt-4">
   
    <p>Welcome to your profile, {{ app.user.name }}!</p>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endfor %}

    {% for message in app.flashes('error') %}
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endfor %}

    <div class="row mt-4">
        {% if is_granted('ROLE_ADMIN') %}
        <div class="col-md-6 mb-3">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="bi bi-shield-lock"></i> Admin Management</h5>
                </div>
                <div class="card-body">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item">
                            <a href="{{ path('admin_user_index') }}" class="text-decoration-none">
                                <i class="bi bi-people"></i> Manage Users
                            </a>
                        </li>
                        <li class="list-group-item">
                            <a href="{{ path('admin_password_reset_index') }}" class="text-decoration-none">
                                <i class="bi bi-key"></i> Password Reset Requests
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
        {% endif %}

        <div class="col-md-6 mb-3">
            <div class="card">
                <div class="card-header bg-secondary text-white">
                    <h5 class="mb-0"><i class="bi bi-person"></i> Account</h5>
                </div>
                <div class="card-body">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item">
                            <a href="{{ path('password_reset_request') }}" class="text-decoration-none">
                                <i class="bi bi-key"></i> Request Password Reset
                            </a>
                        </li>
                        <li class="list-group-item">
                            <a href="{{ path('password_reset_status') }}" class="text-decoration-none">
                                <i class="bi bi-clock-history"></i> View Request Status
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    {% if events|length > 0 %}
    <div class="row mt-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0"><i class="bi bi-calendar-event"></i> Upcoming Events</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Title</th>
                                    <th>Start Date</th>
                                    <th>End Date</th>
                                    <th>Location</th>
                                    <th>Site</th>
                                    <th>Assigned Users</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for event in events %}
                                <tr>
                                    <td>
                                        <a href="{{ path('calendar_show', {slug: event.slug}) }}" target="_blank">
                                            {{ event.title }}
                                        </a>
                                    </td>
                                    <td>{{ event.startAt|date('Y-m-d H:i') }}</td>
                                    <td>{{ event.endAt|date('Y-m-d H:i') }}</td>
                                    <td>{{ event.location ?: '-' }}</td>
                                    <td>{{ event.site ? event.site.domain : '-' }}</td>
                                    <td>
                                        {% if event.assignedUsers|length > 0 %}
                                            {% for user in event.assignedUsers %}
                                                <span class="badge bg-secondary">{{ user.name }}</span>
                                            {% endfor %}
                                        {% else %}
                                            -
                                        {% endif %}
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                    <div class="text-end">
                        <a href="{{ path('admin_event_index') }}" class="btn btn-sm btn-outline-info">
                            View All Events
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
    {% endif %}
</div>
{% endblock %}
