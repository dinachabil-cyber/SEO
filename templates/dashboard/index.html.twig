{% extends 'base.html.twig' %}

{% block title %}Dashboard{% endblock %}

{% block body %}
<div class="container mt-4">
    <h1>Dashboard</h1>
    <p>Welcome{% if app.user %}, {{ app.user.name }}{% endif %}!</p>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endfor %}

    {% for message in app.flashes('error') %}
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endfor %}

    <div class="row mt-4">
        {% if is_granted('ROLE_ADMIN') %}
        <div class="col-md-6 mb-3">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="bi bi-shield-lock"></i> Admin Management</h5>
                </div>
                <div class="card-body">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item">
                            <a href="{{ path('admin_user_index') }}" class="text-decoration-none">
                                <i class="bi bi-people"></i> Manage Users
                            </a>
                        </li>
                        <li class="list-group-item">
                            <a href="{{ path('admin_password_reset_index') }}" class="text-decoration-none">
                                <i class="bi bi-key"></i> Password Reset Requests
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
        {% endif %}

        <div class="col-md-6 mb-3">
            <div class="card">
                <div class="card-header bg-secondary text-white">
                    <h5 class="mb-0"><i class="bi bi-person"></i> Account</h5>
                </div>
                <div class="card-body">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item">
                            <a href="{{ path('password_reset_request') }}" class="text-decoration-none">
                                <i class="bi bi-key"></i> Request Password Reset
                            </a>
                        </li>
                        <li class="list-group-item">
                            <a href="{{ path('password_reset_status') }}" class="text-decoration-none">
                                <i class="bi bi-clock-history"></i> View Request Status
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
