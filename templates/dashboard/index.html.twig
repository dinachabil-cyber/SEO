{% extends 'base.html.twig' %}

{% block title %}Dashboard{% endblock %}

{% block body %}
<div class="container mt-4">
   
    <p>Welcome to your profile, {{ app.user.name }}!</p>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endfor %}

    {% for message in app.flashes('error') %}
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endfor %}

    <div class="row mt-4">
        {% if is_granted('ROLE_ADMIN') %}
        <div class="col-md-6 mb-3">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="bi bi-shield-lock"></i> Admin Management</h5>
                </div>
                <div class="card-body">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item">
                            <a href="{{ path('admin_user_index') }}" class="text-decoration-none">
                                <i class="bi bi-people"></i> Manage Users
                            </a>
                        </li>
                        <li class="list-group-item">
                            <a href="{{ path('admin_password_reset_index') }}" class="text-decoration-none">
                                <i class="bi bi-key"></i> Password Reset Requests
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
        {% endif %}

        <div class="col-md-6 mb-3">
            <div class="card">
                <div class="card-header bg-secondary text-white">
                    <h5 class="mb-0"><i class="bi bi-person"></i> Account</h5>
                </div>
                <div class="card-body">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item">
                            <a href="{{ path('password_reset_request') }}" class="text-decoration-none">
                                <i class="bi bi-key"></i> Request Password Reset
                            </a>
                        </li>
                        <li class="list-group-item">
                            <a href="{{ path('password_reset_status') }}" class="text-decoration-none">
                                <i class="bi bi-clock-history"></i> View Request Status
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0"><i class="bi bi-list-task"></i> My Tasks (your assigned events)</h5>
                </div>
                <div class="card-body">
                    {% set events_list = events|default([]) %}
                    {% if events_list|length > 0 %}
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Title</th>
                                    <th>Start Date</th>
                                    <th>End Date</th>
                                    <th>Location</th>
                                    <th>Site</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for event in events_list %}
                                <tr>
                                    <td>
                                        <a href="{{ path('calendar_show', {slug: event.slug}) }}" target="_blank">
                                            {{ event.title }}
                                        </a>
                                    </td>
                                    <td>{{ event.startAt|date('Y-m-d H:i') }}</td>
                                    <td>{{ event.endAt|date('Y-m-d H:i') }}</td>
                                    <td>{{ event.location ?: '-' }}</td>
                                    <td>{{ event.site ? event.site.domain : '-' }}</td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                    {% else %}
                    <p class="text-muted mb-0">No tasks assigned to you.</p>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    {% if sites|length > 0 %}
    <div class="row mt-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0"><i class="bi bi-briefcase"></i> My Projects</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Domain</th>
                                    <th>Company Name</th>
                                    <th>Status</th>
                                    <th>Pages</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for site in sites %}
                                <tr>
                                    <td>{{ site.domain }}</td>
                                    <td>{{ site.companyName ?: '-' }}</td>
                                    <td>
                                        <span class="badge bg-{{ site.status == 'Published' ? 'success' : 'warning' }}">
                                            {{ site.status }}
                                        </span>
                                    </td>
                                    <td>{{ site.pages|length }}</td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
    {% endif %}
</div>
{% endblock %}
